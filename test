    local a, e = 0, 0
    for _ in pairs(ALLIES)  do a = a + 1 end
    for _ in pairs(ENEMIES) do e = e + 1 end
    TeamStatusLabel.Text = currentArena.Name
        .. "  Allies:" .. a .. "  Enemies:" .. e
end

local function RefreshAllESPColors()
    for plr, data in pairs(ESP_OBJECTS) do
        if not data then continue end
        local col
        if ALLIES[plr]  then col = Color3.fromRGB(50,220,80)
        elseif ENEMIES[plr] then col = Color3.fromRGB(220,50,50)
        else col = Color3.fromRGB(180,180,180) end
        if data.Highlight then
            data.Highlight.FillColor    = col
            data.Highlight.OutlineColor = col
        end
        local lbl = data.Label and data.Label:FindFirstChildOfClass("TextLabel")
        if lbl then lbl.TextColor3 = col end
    end
end

local function ESPColorFor(plr)
    if ALLIES[plr]  then return Color3.fromRGB(50,220,80)  end
    if ENEMIES[plr] then return Color3.fromRGB(220,50,50)  end
    return Color3.fromRGB(180,180,180)
end

