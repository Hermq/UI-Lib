-- How far from any spawn part counts as "at that spawn"
local SPAWN_THRESHOLD = 50   -- studs, generous to handle load-in variance
-- How far from arena center before a player is excluded from ESP/aimbot
local ARENA_RADIUS    = 500  -- studs — generous for varied arena sizes/shapes

--// ══════════════════════════════════════════════════════════════════
--// HELPERS
--// ══════════════════════════════════════════════════════════════════
local function keyName(k)
    if k == nil then return "None" end
    if type(k) == "table" then
        if k.kind == "key"   then return k.val.Name end
        if k.kind == "mouse" then return k.val.Name end
    end
    return "None"
end

local function round1(n)
    return math.floor(n * 10 + 0.5) / 10
end

-- Get all spawn {part, folder} entries from an arena
local function GetSpawnParts(arena)
    local result = {}
    local spawns = arena:FindFirstChild("Spawns")
    if not spawns then return result end
    for _, folder in ipairs(spawns:GetChildren()) do
        -- Each child of Spawns is a folder (named "1", "2", etc.)
        local part = folder:FindFirstChild("Part")
        if part and part:IsA("BasePart") then
            table.insert(result, { part = part, folder = folder, folderName = folder.Name })
        end
    end
    return result
end

-- Which spawn folder is a world position closest to?
-- Returns the folder entry, or nil if beyond SPAWN_THRESHOLD
local function GetNearestSpawnEntry(pos, spawnParts)
    local best, bestDist = nil, math.huge
    for _, sp in ipairs(spawnParts) do
        local d = (pos - sp.part.Position).Magnitude
        if d < bestDist then bestDist = d; best = sp end
    end
    if best and bestDist <= SPAWN_THRESHOLD then return best end
    return nil
end

-- Get arena center — uses average of all spawn parts rather than GetPivot
-- since GetPivot can be unreliable on complex models
local function GetArenaCenter(arena, spawnParts)
    if #spawnParts > 0 then
        local sum = Vector3.new(0,0,0)
        for _, sp in ipairs(spawnParts) do sum = sum + sp.part.Position end
        return sum / #spawnParts
    end
    -- Fallback: try GetPivot
    local ok, p = pcall(function() return arena:GetPivot().Position end)
    return ok and p or Vector3.new(0,0,0)
end

local function IsNearArena(plr, arenaCenter)
    if not plr.Character then return false end
    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    return (hrp.Position - arenaCenter).Magnitude <= ARENA_RADIUS
end

