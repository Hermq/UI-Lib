local cachedArenaCenter = nil

local function GetAimPosition(plr)
    if _G.BIGHEAD_ENABLED and hitboxParts[plr] and hitboxParts[plr].Parent then
        return hitboxParts[plr].Position
    end
    local part = plr.Character and plr.Character:FindFirstChild(_G.AIM_AT)
    return part and part.Position
end

local function IsValidTarget(plr)
    if plr == LocalPlayer     then return false end
    if ALLIES[plr]            then return false end
    if not ENEMIES[plr]       then return false end
    if not plr.Character      then return false end
    -- In-arena check using cached center
    if cachedArenaCenter then
        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        if (hrp.Position - cachedArenaCenter).Magnitude > ARENA_RADIUS then return false end
    end
    return true
end

local function GetClosestEnemy()
    local best, bestDist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if not IsValidTarget(plr) then continue end
        local pos = GetAimPosition(plr)
        if not pos then continue end
        local sp, visible = Camera:WorldToScreenPoint(pos)
        if not visible then continue end
        local d = (Vector2.new(Mouse.X,Mouse.Y) - Vector2.new(sp.X,sp.Y)).Magnitude
        if d < bestDist then bestDist = d; best = plr end
    end
    return best
end

local function AimKeyHeld()
    local k = _G.AIM_KEY; if not k then return false end
    if k.kind=="key"   then return UserInputService:IsKeyDown(k.val) end
    if k.kind=="mouse" then return UserInputService:IsMouseButtonPressed(k.val) end
    return false
end

local function InputMatchesAimKey(input)
    local k = _G.AIM_KEY; if not k then return false end
    if k.kind=="key"   and input.UserInputType==Enum.UserInputType.Keyboard
                       and input.KeyCode==k.val then return true end
    if k.kind=="mouse" and input.UserInputType==k.val then return true end
    return false
end

