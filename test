local function ClearESP(plr)
    if ESP_OBJECTS[plr] then
        pcall(function()
            if ESP_OBJECTS[plr].Label     then ESP_OBJECTS[plr].Label:Destroy()     end
            if ESP_OBJECTS[plr].Highlight then ESP_OBJECTS[plr].Highlight:Destroy() end
        end)
        ESP_OBJECTS[plr] = nil
    end
    if plr:FindFirstChild(TAG_NAME) then plr[TAG_NAME]:Destroy() end
end

local function CreateESP(plr)
    if plr == LocalPlayer then return end
    if not plr.Character then return end
    local head = plr.Character:FindFirstChild("Head")
    if not head then return end
    local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    if plr:FindFirstChild(TAG_NAME) then return end

    local tag = Instance.new("BoolValue"); tag.Name = TAG_NAME; tag.Parent = plr

    local bb = Instance.new("BillboardGui")
    bb.Adornee = head; bb.AlwaysOnTop = true
    bb.Size = UDim2.new(0,170,0,22); bb.StudsOffset = Vector3.new(0,3.5,0)

    local lbl = Instance.new("TextLabel", bb)
    lbl.Size = UDim2.new(1,0,1,0); lbl.BackgroundTransparency = 1
    local col = ESPColorFor(plr)
    lbl.TextColor3 = col; lbl.TextStrokeTransparency = 0.1
    lbl.Font = Enum.Font.SourceSansBold; lbl.TextSize = 13
    lbl.Text = plr.Name .. " | HP:" .. math.floor(humanoid.Health)
    bb.Parent = head

    local hl = Instance.new("Highlight")
    hl.Parent = plr.Character
    hl.FillColor = col; hl.OutlineColor = col
    hl.FillTransparency = 0.65; hl.OutlineTransparency = 0.1

    ESP_OBJECTS[plr] = { Label=bb, Highlight=hl, Humanoid=humanoid }

    humanoid:GetPropertyChangedSignal("Health"):Connect(function()
        if humanoid.Health <= 0 then ClearESP(plr) end
    end)
end

local function UpdateESP()
    for plr, data in pairs(ESP_OBJECTS) do
        if not plr.Character or not data.Humanoid then ClearESP(plr); continue end
        if data.Humanoid.Health <= 0 then ClearESP(plr); continue end
        local lbl = data.Label and data.Label:FindFirstChildOfClass("TextLabel")
        if lbl then
            local hstr = _G.BIGHEAD_ENABLED
                and (" | Box:x"..string.format("%.1f",_G.BIGHEAD_SIZE)) or ""
            lbl.Text = plr.Name .. " | HP:" .. math.floor(data.Humanoid.Health) .. hstr
            local col = ESPColorFor(plr)
            lbl.TextColor3 = col
            if data.Highlight then
                data.Highlight.FillColor    = col
                data.Highlight.OutlineColor = col
            end
        end
    end
end

local function ToggleESP()
    ESP_ENABLED = not ESP_ENABLED
    ESPLabel.Text = "ESP: " .. (ESP_ENABLED and "ON" or "OFF")
    if ESP_ENABLED then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then CreateESP(plr) end
        end
    else
        for plr in pairs(ESP_OBJECTS) do ClearESP(plr) end
    end
end

