local waitingForKey = false
local waitingConn   = nil

local function WaitForInput(btn, onSet)
    if waitingForKey then return end
    waitingForKey = true
    btn.Text = "Press..."
    btn.BackgroundColor3 = Color3.fromRGB(100,65,20)

    local function finish(result)
        onSet(result)
        btn.Text = keyName(result)
        btn.BackgroundColor3 = Color3.fromRGB(40,55,82)
        task.delay(0.05, function() waitingForKey = false end)
        if waitingConn then waitingConn:Disconnect(); waitingConn = nil end
    end

    waitingConn = UserInputService.InputBegan:Connect(function(input, _)
        if input.KeyCode == Enum.KeyCode.Escape then
            finish(nil)
        elseif input.UserInputType == Enum.UserInputType.Keyboard then
            finish({ kind="key", val=input.KeyCode })
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
            finish({ kind="mouse", val=Enum.UserInputType.MouseButton1 })
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
            finish({ kind="mouse", val=Enum.UserInputType.MouseButton2 })
        elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
            finish({ kind="mouse", val=Enum.UserInputType.MouseButton3 })
        end
    end)
end

