--// HITBOX BOX  — visual light-blue box, head Part untouched
--// ══════════════════════════════════════════════════════════════════
local hitboxParts  = {}  -- [Player] = Part
local origHeadSizes = {} -- [Player] = Vector3

local function GetOrigHeadSize(plr)
    if origHeadSizes[plr] then return origHeadSizes[plr] end
    local head = plr.Character and plr.Character:FindFirstChild("Head")
    if head then origHeadSizes[plr] = head.Size; return head.Size end
    return Vector3.new(2,2,2)
end

local function CreateHitboxPart(plr)
    if plr == LocalPlayer then return end
    local char = plr.Character; if not char then return end
    local head = char:FindFirstChild("Head"); if not head then return end
    if hitboxParts[plr] then hitboxParts[plr]:Destroy() end

    local orig = GetOrigHeadSize(plr)
    local box = Instance.new("Part")
    box.Name             = "HeadHitbox"
    box.Size             = orig * _G.BIGHEAD_SIZE
    box.Transparency     = 0.55
    box.Color            = Color3.fromRGB(100,200,255)
    box.Material         = Enum.Material.SmoothPlastic
    box.CanCollide       = false
    box.CastShadow       = false
    box.Anchored         = false
    box.Massless         = true
    box.CFrame           = head.CFrame
    box.Parent           = char

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = head; weld.Part1 = box; weld.Parent = box

    hitboxParts[plr] = box
end

local function RemoveHitboxPart(plr)
    if hitboxParts[plr] then hitboxParts[plr]:Destroy(); hitboxParts[plr] = nil end
end

local function UpdateHitboxSize(plr)
    local box = hitboxParts[plr]
    if not box or not box.Parent then return end
    box.Size = GetOrigHeadSize(plr) * _G.BIGHEAD_SIZE
end

local function ApplyAllHitboxes()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            if not hitboxParts[plr] or not hitboxParts[plr].Parent then
                CreateHitboxPart(plr)
            else
                UpdateHitboxSize(plr)
            end
        end
    end
end

local function RemoveAllHitboxes()
    for plr in pairs(hitboxParts) do RemoveHitboxPart(plr) end
end

local function ToggleBigHead()
    _G.BIGHEAD_ENABLED = not _G.BIGHEAD_ENABLED
    BigHeadLabel.Text = "Big head: " .. (_G.BIGHEAD_ENABLED and "ON" or "OFF")
    if _G.BIGHEAD_ENABLED then ApplyAllHitboxes() else RemoveAllHitboxes() end
end

-- Rebuild hitbox when a player's character respawns
local function SetupHitboxWatcher(plr)
    if plr == LocalPlayer then return end
    plr.CharacterAdded:Connect(function()
        origHeadSizes[plr] = nil
        RemoveHitboxPart(plr)
        if _G.BIGHEAD_ENABLED then
            task.wait(0.2)
            CreateHitboxPart(plr)
        end
    end)
end
for _, plr in ipairs(Players:GetPlayers()) do SetupHitboxWatcher(plr) end
Players.PlayerAdded:Connect(SetupHitboxWatcher)

