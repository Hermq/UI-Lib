--// ARENA DETECTION + TEAM SNAPSHOT
--// ══════════════════════════════════════════════════════════════════

--[[
    FindArenaByProximity: no name matching at all.
    Scans ALL workspace descendants for Parts whose ancestry is:
        workspace -> [Model] -> Spawns -> [Folder] -> Part
    If local player is within SPAWN_THRESHOLD of any such Part, that
    Model is the current arena. Fires correctly regardless of arena
    name, load order, or dynamic swapping.
--]]
local function FindArenaByProximity()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local myPos = hrp.Position

    for _, part in ipairs(workspace:GetDescendants()) do
        if not part:IsA("BasePart")  then continue end
        if part.Name ~= "Part"       then continue end
        local spawnFolder  = part.Parent
        if not spawnFolder then continue end
        local spawnsFolder = spawnFolder.Parent
        if not spawnsFolder or spawnsFolder.Name ~= "Spawns" then continue end
        local arenaModel   = spawnsFolder.Parent
        if not arenaModel  or not arenaModel:IsA("Model")    then continue end
        if arenaModel.Parent ~= workspace                     then continue end
        -- Valid spawn Part found — is the local player near it?
        if (myPos - part.Position).Magnitude <= SPAWN_THRESHOLD then
            return arenaModel
        end
    end
    return nil
end

--[[
    TakeTeamSnapshot — the ONLY place ALLIES/ENEMIES is written.
    Called once, 5 seconds after a new arena is detected.
    Logic:
      1. Collect all spawn parts from the arena.
      2. Find which spawn folder the local player is closest to
         → that is "my spawn folder"
      3. For every other player: find their nearest spawn folder.
         Same folder as mine → ALLY, different → ENEMY.
      4. If a player has no character loaded yet, mark ENEMY by default
         (safe fallback — they'll be reassigned next arena cycle).
--]]
local function TakeTeamSnapshot(arena)
    if not arena or not arena.Parent then return end

    ALLIES  = {}
    ENEMIES = {}

    local spawnParts = GetSpawnParts(arena)

    if #spawnParts == 0 then
        TeamStatusLabel.Text = arena.Name .. " — no Spawns found!"
        return
    end

    -- Find local player's spawn folder
    local myChar = LocalPlayer.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myEntry = myHRP and GetNearestSpawnEntry(myHRP.Position, spawnParts)

    -- Debug: print spawn part positions and local player position to output
    -- (remove these prints once working)
    print("[PL] Arena:", arena.Name, "| Spawn parts found:", #spawnParts)
    for i, sp in ipairs(spawnParts) do
        print("  Spawn["..i.."] folder='"..sp.folderName.."' pos="..tostring(sp.part.Position))
    end
    if myHRP then
        print("  LocalPlayer pos="..tostring(myHRP.Position))
        print("  My nearest spawn folder:", myEntry and myEntry.folderName or "NONE (too far)")
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end

        local char = plr.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")

        if not hrp then
            -- Character not loaded — default enemy
            ENEMIES[plr] = true
            print("  "..plr.Name..": no HRP → ENEMY (default)")
        else
            local entry = GetNearestSpawnEntry(hrp.Position, spawnParts)
            print("  "..plr.Name.." pos="..tostring(hrp.Position)
                .." nearest="..(entry and entry.folderName or "NONE"))
            if myEntry and entry and entry.folderName == myEntry.folderName then
                ALLIES[plr] = true
                print("    → ALLY")
            else
                ENEMIES[plr] = true
                print("    → ENEMY")
            end
        end
    end

    UpdateStatusLabel()
    RefreshAllESPColors()
    arenaSnapshotPending = false
end

-- Called from render loop when a new arena is detected
local function OnNewArenaDetected(arena)
    if arenaSnapshotPending then return end  -- already scheduled
    arenaSnapshotPending = true
    currentArena = arena
    ALLIES  = {}
    ENEMIES = {}
    TeamStatusLabel.Text = "New arena: " .. arena.Name .. " — loading teams in 5s..."
    print("[PL] New arena detected:", arena.Name, "— snapshot in 5s")

    task.delay(5, function()
        TakeTeamSnapshot(arena)
    end)
end

