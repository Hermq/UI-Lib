        local function visuals()
            svHolder.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
            svCur.Position = UDim2.new(math.clamp(s,0,1), 0, 1 - math.clamp(v,0,1), 0)
            hCur.Position = UDim2.new(h, 0, 0, 0)
            aCur.Position = UDim2.new(alpha, 0, 0, 0)
            clr = Color3.fromHSV(h, s, v)
            prev.BackgroundColor3 = clr; prev.BackgroundTransparency = 1 - alpha
            if not hexBox:IsFocused() then hexBox.Text = clr:ToHex():upper() end
            aLbl.Text = ("Opacity %d%%"):format(math.round(alpha * 100))
            aGrad.Color = ColorSequence.new(Color3.fromRGB(40,40,40), clr)
            if flag then NexusLib.Flags[flag] = clr end
        end
        local function changed() visuals(); cb(clr, alpha) end
        visuals()

        local conns = {}
        local dragging = nil
        local function handle(pos)
            if dragging == "sv" then
                local ap, as = svHolder.AbsolutePosition, svHolder.AbsoluteSize
                s = math.clamp((pos.X - ap.X) / math.max(as.X,1), 0, 1)
                v = 1 - math.clamp((pos.Y - ap.Y) / math.max(as.Y,1), 0, 1)
            elseif dragging == "h" then
                h = math.clamp((pos.X - hueHolder.AbsolutePosition.X) / math.max(hueHolder.AbsoluteSize.X,1), 0, 1)
            elseif dragging == "a" then
                alpha = math.clamp((pos.X - aHolder.AbsolutePosition.X) / math.max(aHolder.AbsoluteSize.X,1), 0, 1)
            end
            changed()
        end
        local function hook(frame, key)
            local hit = MakeButton({Size=UDim2.fromScale(1,1), BackgroundTransparency=1, ZIndex=Z+6, Parent=frame})
            hit.InputBegan:Connect(function(i)
                if IsPress(i) then dragging = key; handle(PointerPos(i)) end
            end)
        end
        hook(svHolder, "sv"); hook(hueHolder, "h"); hook(aHolder, "a")
        EC(conns, UserInputService.InputChanged:Connect(function(i)
            if dragging and IsMove(i) then handle(PointerPos(i)) end
        end))
        EC(conns, UserInputService.InputEnded:Connect(function(i)
            if IsPress(i) then dragging = nil end
        end))
        hexBox.FocusLost:Connect(function()
            local hex = hexBox.Text:gsub("#", ""):gsub("[^%x]", "")
            if #hex == 6 then
                local nc = Color3.fromRGB(tonumber(hex:sub(1,2),16), tonumber(hex:sub(3,4),16), tonumber(hex:sub(5,6),16))
                h, s, v = Color3.toHSV(nc); changed()
            else visuals() end
        end)
        local col = Collapsible(clip, function() return pll.AbsoluteContentSize.Y + 16 + 4 end, nil, false)
        pll:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() col:Follow() end)
        prev.MouseButton1Click:Connect(function()
            task.spawn(function() col:Animate(not col.expanded, 0.28) end)
        end)
        local Cp = {}
        function Cp:Set(c, a)
            if typeof(c) == "Color3" then h, s, v = Color3.toHSV(c) end
            if a ~= nil then alpha = math.clamp(a, 0, 1) end
            visuals()
        end
        function Cp:Get() return clr end
        function Cp:GetAlpha() return alpha end
        function Cp:SetCallback(f) cb = f end
        Cp._cfgGet = function() return clr:ToHex() end
        Cp._cfgSet = function(v) local ok, c = pcall(Color3.fromHex, v); if ok then Cp:Set(c); cb(clr, alpha) end end
        if flag then NexusLib.Options[flag] = Cp end
        meta(Cp, "ColorPicker", n, n .. " " .. (o.Description or ""), o)
        return finish(row, Cp, conns)
