        R(panel, "BackgroundColor3", "TertiaryBg"); MakeCorner(panel, 6)
        local pp = Instance.new("UIPadding")
        pp.PaddingLeft = UDim.new(0,8); pp.PaddingRight = UDim.new(0,8)
        pp.PaddingTop = UDim.new(0,8); pp.PaddingBottom = UDim.new(0,8); pp.Parent = panel
        local pll = Instance.new("UIListLayout"); pll.SortOrder = Enum.SortOrder.LayoutOrder
        pll.Padding = UDim.new(0,6); pll.Parent = panel
        local svHolder = MakeFrame({Size=UDim2.new(1,0,0,120), ZIndex=Z+1, LayoutOrder=1, Parent=panel})
        MakeCorner(svHolder, 4)
        local svWhite = MakeFrame({Size=UDim2.fromScale(1,1), BackgroundColor3=Color3.new(1,1,1), ZIndex=Z+2, Parent=svHolder})
        MakeCorner(svWhite, 4)
        local wg2 = Instance.new("UIGradient")
        wg2.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,0), NumberSequenceKeypoint.new(1,1)})
        wg2.Parent = svWhite
        local svDark = MakeFrame({Size=UDim2.fromScale(1,1), BackgroundColor3=Color3.new(0,0,0), ZIndex=Z+3, Parent=svHolder})
        MakeCorner(svDark, 4)
        local bGrad = Instance.new("UIGradient")
        bGrad.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,1), NumberSequenceKeypoint.new(1,0)})
        bGrad.Rotation = 90; bGrad.Parent = svDark
        local svCur = MakeFrame({Size=UDim2.fromOffset(10,10), AnchorPoint=Vector2.new(0.5,0.5),
            BackgroundColor3=Color3.new(1,1,1), ZIndex=Z+5, Parent=svHolder})
        MakeCorner(svCur, 5); MakeStroke(svCur, Color3.new(0,0,0), 2)
        local hueHolder = MakeFrame({Size=UDim2.new(1,0,0,16), BackgroundColor3=Color3.new(1,1,1),
