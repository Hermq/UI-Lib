    -- ── PARAGRAPH ───────────────────────────────────────
    function obj:AddParagraph(o)
        o = o or {}
        local row = newRow(0)
        row.AutomaticSize = Enum.AutomaticSize.Y
        local rpad = Instance.new("UIPadding"); rpad.PaddingTop = UDim.new(0,2); rpad.PaddingBottom = UDim.new(0,2); rpad.Parent = row
        local bg2 = MakeFrame({Size=UDim2.new(1,-2*inset,0,0), Position=UDim2.new(0,inset,0,0),
            AutomaticSize=Enum.AutomaticSize.Y, ZIndex=Z, Parent=row})
        R(bg2, "BackgroundColor3", "ElementBg"); MakeCorner(bg2, 6)
        local pad = Instance.new("UIPadding")
        pad.PaddingLeft = UDim.new(0,10); pad.PaddingRight = UDim.new(0,10)
        pad.PaddingTop = UDim.new(0,8); pad.PaddingBottom = UDim.new(0,8); pad.Parent = bg2
        local ll2 = Instance.new("UIListLayout"); ll2.SortOrder = Enum.SortOrder.LayoutOrder
        ll2.Padding = UDim.new(0,4); ll2.Parent = bg2
        local tl = MakeLabel({Size=UDim2.new(1,0,0,18), Text=o.Title or "", Font=Enum.Font.GothamBold,
            TextSize=13, TextXAlignment=Enum.TextXAlignment.Left, LayoutOrder=1, ZIndex=Z+1, Parent=bg2})
        R(tl, "TextColor3", "TextPrimary")
        local bl = MakeLabel({Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
            Text=o.Body or "", TextSize=12, TextWrapped=true, LayoutOrder=2,
            TextXAlignment=Enum.TextXAlignment.Left, ZIndex=Z+1, Parent=bg2})
        R(bl, "TextColor3", "TextSecondary")
