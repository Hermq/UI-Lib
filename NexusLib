-- ── Library Methods ───────────────────────────────────────
function NexusLib:OnUnload(fn)
    if type(fn) == "function" then table.insert(self._unload, fn) end
end

function NexusLib:Destroy()
    if self._destroyed then return end
    self._destroyed = true
    for _, fn in ipairs(self._unload) do
        local ok, err = pcall(fn)
        if not ok then warn("[NexusLib] OnUnload error: " .. tostring(err)) end
    end
    self._unload = {}
    for _, c in pairs(self.Connections) do
        pcall(function() c:Disconnect() end)
    end
    self.Connections = {}; self.Flags = {}; self.Options = {}; self._listening = false
    if self._gui and self._gui.Parent then pcall(function() self._gui:Destroy() end) end
    if getgenv and getgenv()._NexusLibInstance == self then getgenv()._NexusLibInstance = nil end
end

function NexusLib:SetTheme(t)
    self._theme = type(t) == "string" and (self.Themes[t] or self.Themes.Dark) or t
end
NexusLib:SetTheme("Dark")

