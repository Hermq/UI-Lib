    -- ── TOGGLE ──────────────────────────────────────────
    -- 3.1: Keybind = "F" / KeyCode / true (unbound) adds a key button that flips
    -- the toggle; KeybindNotify = true/false overrides the window setting.
    function obj:AddToggle(o)
        o = o or {}
        local n = o.Name or "Toggle"; local d = o.Description; local st = o.Default or false
        local flag = o.Flag; local cb = o.Callback or function() end
        local rh = d and 54 or 36
        if flag then NexusLib.Flags[flag] = st end
        local hasKey = o.Keybind ~= nil and o.Keybind ~= false
        local rightPad = hasKey and 128 or 66
        local row = newRow(rh)
        local bg = newBg(row, rh-4, true)
        AddHoverScale(bg); AddPressScale(bg); AddGlow(bg, th)
        local nl = MakeLabel({Size=UDim2.new(1,-rightPad,0,20), Position=UDim2.new(0,10,0,d and 7 or 6),
            Text=n, TextSize=13, TextXAlignment=Enum.TextXAlignment.Left,
            TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=Z+1, Parent=bg})
        R(nl, "TextColor3", "TextPrimary")
        if d then
            local dl = MakeLabel({Size=UDim2.new(1,-rightPad,0,16), Position=UDim2.new(0,10,0,27),
                Text=d, TextSize=11, TextXAlignment=Enum.TextXAlignment.Left,
                TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=Z+1, Parent=bg})
            R(dl, "TextColor3", "TextDim")
        end
        local pill = MakeFrame({Size=UDim2.new(0,36,0,20), Position=UDim2.new(1,-46,0.5,-10), ZIndex=Z+1, Parent=bg})
        MakeCorner(pill, 10)
        local dot = MakeFrame({Size=UDim2.new(0,14,0,14),
            Position=st and UDim2.new(0,19,0.5,-7) or UDim2.new(0,3,0.5,-7),
            BackgroundColor3=Color3.new(1,1,1), ZIndex=Z+2, Parent=pill})
        MakeCorner(dot, 7)
        local function paint() pill.BackgroundColor3 = st and th().ToggleOn or th().ToggleOff end
        paint(); RF(paint)
        local Tog = {}
        local function SetSt(s, fire)
            s = s and true or false
            st = s; if flag then NexusLib.Flags[flag] = s end
            Tween(pill, {BackgroundColor3 = s and th().ToggleOn or th().ToggleOff}, 0.2)
            Tween(dot, {Size=UDim2.new(0,18,0,14)}, 0.07)
            task.delay(0.07, function()
                Tween(dot, {Position = s and UDim2.new(0,19,0.5,-7) or UDim2.new(0,3,0.5,-7)}, 0.2, Enum.EasingStyle.Quart)
                TweenSpring(dot, {Size=UDim2.new(0,14,0,14)}, 0.25)
            end)
            if fire then cb(s) end
        end
        hoverBg(bg)
        bg.MouseButton1Click:Connect(function() SetSt(not st, true) end)
        function Tog:Set(s, fire) SetSt(s, fire == true) end
        function Tog:Get() return st end
        function Tog:Toggle(fire) SetSt(not st, fire ~= false) end
        function Tog:SetCallback(f) cb = f end
        Tog._cfgGet = function() return st end
        Tog._cfgSet = function(v) SetSt(v == true, true) end

        -- inline keybind
        local conns = {}
        local key, kbtn, listening = nil, nil, false
        if hasKey then
            key = o.Keybind
            if type(key) == "string" then pcall(function() key = Enum.KeyCode[key] end) end
            if typeof(key) ~= "EnumItem" then key = nil end
            kbtn = MakeButton({Size=UDim2.new(0,56,0,20), Position=UDim2.new(1,-108,0.5,-10),
                Text=key and key.Name or "None", Font=Enum.Font.GothamBold, TextSize=11, ZIndex=Z+3, Parent=bg})
            R(kbtn, "BackgroundColor3", "TertiaryBg"); MakeCorner(kbtn, 5)
            kbtn.TextColor3 = th().TextSecondary
            RF(function() if not listening then kbtn.TextColor3 = th().TextSecondary end end)
            local KBo = {}
            local function stop()
                if not listening then return end
                listening = false
                if activeKeybind == KBo then activeKeybind = nil end
                NexusLib._listening = activeKeybind ~= nil
                kbtn.Text = key and key.Name or "None"; kbtn.TextColor3 = th().TextSecondary
            end
            KBo._cancel = stop
            kbtn.MouseButton1Click:Connect(function()
                if listening then stop(); return end
                if activeKeybind and activeKeybind ~= KBo then pcall(activeKeybind._cancel) end
                listening = true; activeKeybind = KBo; NexusLib._listening = true
                kbtn.Text = "..."; kbtn.TextColor3 = th().Accent
            end)
            EC(conns, UserInputService.InputBegan:Connect(function(inp, gp)
                if listening then
                    if inp.UserInputType == Enum.UserInputType.Keyboard then
                        local k = inp.KeyCode
                        if k == Enum.KeyCode.Escape or k == Enum.KeyCode.Backspace then key = nil
                        elseif not BLOCKED_KEYS[k] then key = k end
                        stop()
                    elseif IsPress(inp) then
                        task.defer(function()
                            local mp = PointerPos(inp)
                            local ap, as = kbtn.AbsolutePosition, kbtn.AbsoluteSize
                            if not (mp.X >= ap.X and mp.X <= ap.X + as.X and mp.Y >= ap.Y and mp.Y <= ap.Y + as.Y) then stop() end
                        end)
                    end
                    return
                end
                if NexusLib._listening or gp then return end
                if inp.UserInputType == Enum.UserInputType.Keyboard and key and inp.KeyCode == key then
                    SetSt(not st, true)
                    local show = o.KeybindNotify
                    if show == nil then show = NexusLib.KeybindNotifications end
                    if show then notifyToggle(n, st) end
                end
            end))
            Tog._onDestroy = function() stop() end
        end
        function Tog:GetKey() return key end
        function Tog:SetKey(k)
            if type(k) == "string" then local ok, kk = pcall(function() return Enum.KeyCode[k] end); k = ok and kk or nil end
            if typeof(k) ~= "EnumItem" then k = nil end
            key = k
            if kbtn and not listening then kbtn.Text = key and key.Name or "None" end
        end
        if flag then NexusLib.Options[flag] = Tog end
        meta(Tog, "Toggle", n, n .. " " .. (d or ""), o)
        local E = finish(row, Tog, conns)
        if hasKey and ctx.win and ctx.win._register and not ctx.noSave and not o.NoSave then
            ctx.win._register((ctx.path or "?") .. "/" .. n .. " [Key]", {_row = row,
                _cfgGet = function() return key and key.Name or "None" end,
                _cfgSet = function(v) Tog:SetKey(v ~= "None" and v or nil) end})
        end
        return E
    end

    -- ── SLIDER ──────────────────────────────────────────
    function obj:AddSlider(o)
        o = o or {}
        local n = o.Name or "Slider"
        local smin, smax = o.Min or 0, o.Max or 100
        if smax < smin then smin, smax = smax, smin end
        local sfx = o.Suffix or ""
        local prec = o.Precision or 0
        local step = o.Increment
        if step then
            local s = tostring(step); local dot = s:find("%.")
            if dot then prec = math.max(prec, #s - dot) end
        else
            step = prec > 0 and 10 ^ (-prec) or 1
        end
        local flag = o.Flag; local cb = o.Callback or function() end
        -- 3.1 AllowOverflow (alias TypeAny): Max is only the drag range; a bigger typed /
        -- set value stretches the slider instead of being clamped
        local overflow = o.AllowOverflow or o.TypeAny
        local baseMax = smax
        local function fit(v)
            v = tonumber(v)
            if overflow and v then smax = math.max(baseMax, v) end
        end
        fit(o.Default)
        local function snap(v)
            v = tonumber(v) or smin
            v = math.clamp(v, smin, smax)
            v = smin + math.floor((v - smin) / step + 0.5) * step
            v = math.clamp(v, smin, smax)
            if prec > 0 then v = tonumber(string.format("%." .. prec .. "f", v)) or v
            else v = math.floor(v + 0.5) end
            return v
        end
        local function fmt(v)
            return (prec > 0 and string.format("%." .. prec .. "f", v) or tostring(v)) .. sfx
        end
        local val = snap(o.Default or smin)
        if flag then NexusLib.Flags[flag] = val end

        local row = newRow(54)
        local bg = newBg(row, 48)
        AddGlow(bg, th)
        local nl = MakeLabel({Size=UDim2.new(1,-100,0,20), Position=UDim2.new(0,10,0,6), Text=n,
            TextSize=13, TextXAlignment=Enum.TextXAlignment.Left,
            TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=Z+1, Parent=bg})
        R(nl, "TextColor3", "TextPrimary")
        local vbox = Instance.new("TextBox")
        vbox.Size = UDim2.new(0,74,0,22); vbox.Position = UDim2.new(1,-82,0,6)
        vbox.Font = Enum.Font.GothamBold; vbox.TextSize = 12; vbox.BorderSizePixel = 0
        vbox.ClearTextOnFocus = false; vbox.ZIndex = Z+1; vbox.Parent = bg
        R(vbox, "BackgroundColor3", "TertiaryBg"); R(vbox, "TextColor3", "Accent"); MakeCorner(vbox, 4)
        local track = MakeFrame({Size=UDim2.new(1,-20,0,6), Position=UDim2.new(0,10,0,35), ZIndex=Z+1, Parent=bg})
        R(track, "BackgroundColor3", "TertiaryBg"); MakeCorner(track, 3)
        local fill = MakeFrame({Size=UDim2.new(0,0,1,0), ZIndex=Z+2, Parent=track})
        R(fill, "BackgroundColor3", "Accent"); MakeCorner(fill, 3)
        local thumb = MakeFrame({Size=UDim2.new(0,14,0,14), AnchorPoint=Vector2.new(0.5,0.5),
            BackgroundColor3=Color3.new(1,1,1), ZIndex=Z+3, Parent=track})
        MakeCorner(thumb, 7)

        local sliding = false
        local function visuals(animate)
            local p = (smax > smin) and (val - smin) / (smax - smin) or 0
            if animate then
                Tween(fill, {Size=UDim2.new(p,0,1,0)}, 0.18)
                Tween(thumb, {Position=UDim2.new(p,0,0.5,0)}, 0.18)
            else
                fill.Size = UDim2.new(p,0,1,0); thumb.Position = UDim2.new(p,0,0.5,0)
            end
            if not vbox:IsFocused() then vbox.Text = fmt(val) end
        end
        local function setValue(v, fire, animate)
            v = snap(v)
            local changed = v ~= val
            val = v
            if flag then NexusLib.Flags[flag] = val end
            visuals(animate)
            if fire and changed then cb(val) end
        end
        visuals(false)
        local function slideFromX(x)
            local ap, as = track.AbsolutePosition, track.AbsoluteSize
            local p = math.clamp((x - ap.X) / math.max(as.X, 1), 0, 1)
            setValue(smin + (smax - smin) * p, true, false)
        end
        local hitArea = MakeButton({Size=UDim2.new(1,-12,0,24), Position=UDim2.new(0,6,0,26),
            BackgroundTransparency=1, ZIndex=Z+4, Parent=bg})
        local conns = {}
        hitArea.InputBegan:Connect(function(i)
            if IsPress(i) then
                sliding = true
                slideFromX(PointerPos(i).X)
                TweenSpring(thumb, {Size=UDim2.new(0,18,0,18)}, 0.15)
            end
        end)
        EC(conns, UserInputService.InputChanged:Connect(function(i)
            if sliding and IsMove(i) then slideFromX(PointerPos(i).X) end
        end))
        EC(conns, UserInputService.InputEnded:Connect(function(i)
            if sliding and IsPress(i) then
                sliding = false
                TweenSine(thumb, {Size=UDim2.new(0,14,0,14)}, 0.15)
            end
        end))
        vbox.Focused:Connect(function()
            vbox.Text = prec > 0 and string.format("%." .. prec .. "f", val) or tostring(val)
        end)
        vbox.FocusLost:Connect(function()
            local num = tonumber((vbox.Text:gsub("[^%d%.%-]", "")))
            if num then fit(num); setValue(num, true, true) else visuals(false) end
            vbox.Text = fmt(val)
        end)
        local Sli = {}
        function Sli:Set(v) fit(v); setValue(v, false, true) end
        function Sli:Get() return val end
        function Sli:SetCallback(f) cb = f end
        function Sli:SetRange(a, b) smin, smax = a, b; baseMax = b; fit(val); setValue(val, false, true) end
        Sli._cfgGet = function() return val end
        Sli._cfgSet = function(v) fit(v); setValue(v, true, true) end
        if flag then NexusLib.Options[flag] = Sli end
        meta(Sli, "Slider", n, n .. " " .. (o.Description or ""), o)
        return finish(row, Sli, conns)
    end

    -- ── KEYBIND ─────────────────────────────────────────
    function obj:AddKeybind(o)
        o = o or {}
        local n = o.Name or "Keybind"; local flag = o.Flag
        local cb = o.Callback or function() end
        local rcb = o.ReleaseCallback
        local cur = o.Default
        if type(cur) == "string" then cur = Enum.KeyCode[cur] end
        if flag then NexusLib.Flags[flag] = cur end
        local listening = false
        local row = newRow(36)
        local bg = newBg(row, 32)
        AddGlow(bg, th)
        local nl = MakeLabel({Size=UDim2.new(1,-120,1,0), Position=UDim2.new(0,10,0,0), Text=n,
            TextSize=13, TextXAlignment=Enum.TextXAlignment.Left,
            TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=Z+1, Parent=bg})
        R(nl, "TextColor3", "TextPrimary")
        local kbtn = MakeButton({Size=UDim2.new(0,94,0,22), Position=UDim2.new(1,-102,0.5,-11),
            Text=cur and cur.Name or "None", Font=Enum.Font.GothamBold, TextSize=12, ZIndex=Z+1, Parent=bg})
        R(kbtn, "BackgroundColor3", "TertiaryBg"); MakeCorner(kbtn, 5)
        kbtn.TextColor3 = th().TextSecondary
        RF(function() if not listening then kbtn.TextColor3 = th().TextSecondary end end)
        AddHoverScale(kbtn); AddPressScale(kbtn)
        local KB = {}
        local function showKey()
            kbtn.Text = cur and cur.Name or "None"
            kbtn.BackgroundTransparency = 0
        end
        local function stop()
            if not listening then return end
            listening = false
            if activeKeybind == KB then activeKeybind = nil end
            NexusLib._listening = activeKeybind ~= nil
            kbtn.TextColor3 = th().TextSecondary
            showKey()
        end
        KB._cancel = stop
        local function pulse()
            if not listening then return end
            Tween(kbtn, {BackgroundTransparency=0.45}, 0.35)
            task.delay(0.36, function()
                if not listening then return end
                Tween(kbtn, {BackgroundTransparency=0}, 0.35)
                task.delay(0.36, pulse)
            end)
        end
        kbtn.MouseButton1Click:Connect(function()
            if listening then stop(); return end
            if activeKeybind and activeKeybind ~= KB then pcall(activeKeybind._cancel) end
            listening = true; activeKeybind = KB; NexusLib._listening = true
            kbtn.Text = "..."; kbtn.TextColor3 = th().Accent
            pulse()
        end)
        local conns = {}
        EC(conns, UserInputService.InputBegan:Connect(function(inp, gp)
            if listening then
                if inp.UserInputType == Enum.UserInputType.Keyboard then
                    local k = inp.KeyCode
                    if k == Enum.KeyCode.Escape or k == Enum.KeyCode.Backspace then
                        cur = nil
                    elseif not BLOCKED_KEYS[k] then
                        cur = k
                    end
                    if flag then NexusLib.Flags[flag] = cur end
                    stop()
                    if cur then
                        kbtn.TextColor3 = th().Accent
                        task.delay(0.4, function() if not listening then kbtn.TextColor3 = th().TextSecondary end end)
                    end
                elseif IsPress(inp) then
                    -- clicking anywhere other than the button cancels
                    task.defer(function()
                        local mp = PointerPos(inp)
                        local ap, as = kbtn.AbsolutePosition, kbtn.AbsoluteSize
                        if not (mp.X >= ap.X and mp.X <= ap.X + as.X and mp.Y >= ap.Y and mp.Y <= ap.Y + as.Y) then stop() end
                    end)
                end
                return
            end
            if NexusLib._listening or gp then return end
            if inp.UserInputType == Enum.UserInputType.Keyboard and cur and inp.KeyCode == cur then cb() end
        end))
        EC(conns, UserInputService.InputEnded:Connect(function(inp)
            if listening or not rcb then return end
            if inp.UserInputType == Enum.UserInputType.Keyboard and cur and inp.KeyCode == cur then rcb() end
        end))
        function KB:Set(k)
            if type(k) == "string" then k = Enum.KeyCode[k] end
            cur = k; if flag then NexusLib.Flags[flag] = k end
            if not listening then showKey() end
        end
        function KB:Get() return cur end
        function KB:SetCallback(f) cb = f end
        function KB:SetReleaseCallback(f) rcb = f end
        KB._onDestroy = function() stop() end
        KB._cfgGet = function() return cur and cur.Name or "None" end
        KB._cfgSet = function(v) if v == "None" then KB:Set(nil) else pcall(function() KB:Set(v) end) end end
        if flag then NexusLib.Options[flag] = KB end
        meta(KB, "Keybind", n, n .. " " .. (o.Description or ""), o)
        return finish(row, KB, conns)
    end

    -- ── DROPDOWN ────────────────────────────────────────
    -- Single: Callback(item). Multi = true: Callback({selected...}).
    -- Items may be a table or a function returning a table.
    function obj:AddDropdown(o)
        o = o or {}
        if o.Inline or (o.Inline == nil and ctx.win and ctx.win._inlineDropdowns) then return addInlineDropdown(o) end
        local n = o.Name or "Dropdown"; local itemsSrc = o.Items or {}
        local multi = o.Multi == true
        local flag = o.Flag; local cb = o.Callback or function() end
        local placeholder = o.Placeholder or (multi and "None" or "Select...")
        local searchOn = o.Search ~= false
        local selected
        if multi then
            selected = {}
            if type(o.Default) == "table" then for _, v in ipairs(o.Default) do table.insert(selected, v) end end
        else
            selected = o.Default
        end
        local function copySel()
            if not multi then return selected end
            local c = {}; for i, v in ipairs(selected) do c[i] = v end; return c
        end
        if flag then NexusLib.Flags[flag] = copySel() end
        local function getItems()
            local it = itemsSrc
            if type(it) == "function" then local ok, r = pcall(it); it = ok and r or {} end
            return type(it) == "table" and it or {}
        end
        local function isSel(item)
            if multi then return table.find(selected, item) ~= nil end
            return selected == item
        end
        local function summary()
            if multi then
                if #selected == 0 then return placeholder end
                if #selected <= 2 then
                    local t = {}; for i, v in ipairs(selected) do t[i] = tostring(v) end
                    return table.concat(t, ", ")
                end
                return #selected .. " selected"
            end
            return selected ~= nil and tostring(selected) or placeholder
        end

        local row = newRow(36)
        local bg = newBg(row, 32)
        AddGlow(bg, th)
        local nl = MakeLabel({Size=UDim2.new(0.42,-10,1,0), Position=UDim2.new(0,10,0,0), Text=n,
            TextSize=13, TextXAlignment=Enum.TextXAlignment.Left,
            TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=Z+1, Parent=bg})
        R(nl, "TextColor3", "TextPrimary")
        local holder = MakeButton({Size=UDim2.new(0.58,-8,0,24), Position=UDim2.new(0.42,0,0.5,-12), ZIndex=Z+1, Parent=bg})
        R(holder, "BackgroundColor3", "TertiaryBg"); MakeCorner(holder, 5)
        local hStroke = MakeStroke(holder, th().Border, 1)
        local disp = MakeLabel({Size=UDim2.new(1,-30,1,0), Position=UDim2.new(0,8,0,0), Text=summary(),
            TextSize=12, TextXAlignment=Enum.TextXAlignment.Left,
            TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=Z+2, Parent=holder})
        local function paintDisp()
            local empty = (multi and #selected == 0) or (not multi and selected == nil)
            disp.Text = summary()
            disp.TextColor3 = empty and th().TextSecondary or th().Accent
        end
        paintDisp(); RF(paintDisp)
        local chev = Icons.Chevron(holder, th().TextDim, Z+2)
        chev.Position = UDim2.new(1,-13,0.5,0); chev.Rotation = 0

        -- floating panel
        local ITEM_H, MAX_VIS = 28, 7
        local shell = MakeFrame({Name="NexusDropdown", Size=UDim2.fromOffset(200,0),
            BackgroundTransparency=1, ZIndex=100, Visible=false, Parent=gui})
        MakeCorner(shell, 8)
        local pStroke = MakeStroke(shell, th().Border, 1); pStroke.Transparency = 1
        local canvas = Instance.new("CanvasGroup")
        canvas.Size = UDim2.fromScale(1,1); canvas.BackgroundTransparency = 1
        canvas.GroupTransparency = 1; canvas.ZIndex = 101; canvas.Parent = shell
        MakeCorner(canvas, 8)
        local topH = searchOn and 34 or 4
        local search
        if searchOn then
            search = Instance.new("TextBox")
            search.Size = UDim2.new(1,-12,0,24); search.Position = UDim2.new(0,6,0,6)
            search.PlaceholderText = "Search..."; search.Text = ""; search.ClearTextOnFocus = false
            search.Font = Enum.Font.Gotham; search.TextSize = 12; search.BorderSizePixel = 0
            search.TextXAlignment = Enum.TextXAlignment.Left; search.ZIndex = 102; search.Parent = canvas
            MakeCorner(search, 5)
            local sp = Instance.new("UIPadding"); sp.PaddingLeft = UDim.new(0,8); sp.Parent = search
        end
        local list = Instance.new("ScrollingFrame")
        list.Size = UDim2.new(1,-8,1,-(topH+4)); list.Position = UDim2.new(0,4,0,topH)
        list.BackgroundTransparency = 1; list.BorderSizePixel = 0; list.ScrollBarThickness = 3
        list.AutomaticCanvasSize = Enum.AutomaticSize.Y; list.CanvasSize = UDim2.new()
        list.ZIndex = 102; list.Parent = canvas
        local lll = Instance.new("UIListLayout"); lll.SortOrder = Enum.SortOrder.LayoutOrder
        lll.Padding = UDim.new(0,2); lll.Parent = list

        local open = false; local token = 0; local follow = nil
        local D = {}
        local rowsByItem = {}
        local function filterText() return search and search.Text:lower() or "" end
        local function filtered()
            local out, f = {}, filterText()
            for _, item in ipairs(getItems()) do
                if f == "" or tostring(item):lower():find(f, 1, true) then table.insert(out, item) end
            end
            return out
        end
        local function paintRow(r, item, instant)
            local on = isSel(item); local t = th()
            local dur = instant and 0 or 0.16
            Tween(r.btn, {BackgroundColor3 = on and t.ElementHover or t.TertiaryBg}, dur)
            Tween(r.lbl, {TextColor3 = on and (multi and t.TextPrimary or t.Accent) or t.TextSecondary}, dur)
            if r.box then
                Tween(r.box, {BackgroundColor3 = on and t.Accent or t.ElementBg}, dur)
                Tween(r.dot, {Size = on and UDim2.fromOffset(7,7) or UDim2.fromOffset(0,0)}, dur)
            end
        end
        local function panelHeight(count)
            return topH + math.max(math.min(count, MAX_VIS), 1) * (ITEM_H + 2) + 6
        end
        local function rebuild()
            for _, c in ipairs(list:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
            table.clear(rowsByItem)
            local items = filtered()
            local t = th()
            shell.BackgroundColor3 = t.SecondaryBg; pStroke.Color = t.Border
            list.ScrollBarImageColor3 = t.ScrollBar
            if search then
                search.BackgroundColor3 = t.TertiaryBg; search.TextColor3 = t.TextPrimary
                search.PlaceholderColor3 = t.TextDim
            end
            if #items == 0 then
                MakeLabel({Size=UDim2.new(1,0,0,ITEM_H), Text="No entries", TextSize=12,
                    TextColor3=t.TextDim, ZIndex=103, Parent=list})
            end
            for i, item in ipairs(items) do
                local b = MakeButton({Size=UDim2.new(1,-4,0,ITEM_H), BackgroundColor3=t.TertiaryBg,
                    LayoutOrder=i, ZIndex=103, Parent=list})
                MakeCorner(b, 5)
                local r = {btn = b}
                local lx = 10
                if multi then
                    r.box = MakeFrame({Size=UDim2.fromOffset(14,14), Position=UDim2.new(0,8,0.5,-7),
                        BackgroundColor3=t.ElementBg, ZIndex=104, Parent=b})
                    MakeCorner(r.box, 4)
                    r.dot = MakeFrame({AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0.5,0.5),
                        Size=UDim2.fromOffset(0,0), BackgroundColor3=Color3.new(1,1,1), ZIndex=105, Parent=r.box})
                    MakeCorner(r.dot, 2)
                    lx = 30
                end
                r.lbl = MakeLabel({Size=UDim2.new(1,-lx-6,1,0), Position=UDim2.new(0,lx,0,0),
                    Text=tostring(item), TextSize=12, TextColor3=t.TextSecondary,
                    TextXAlignment=Enum.TextXAlignment.Left, TextTruncate=Enum.TextTruncate.AtEnd,
                    ZIndex=104, Parent=b})
                paintRow(r, item, true)
                b.MouseEnter:Connect(function()
                    if not isSel(item) then Tween(b, {BackgroundColor3=th().ElementBg}, 0.1) end
                end)
                b.MouseLeave:Connect(function() paintRow(r, item) end)
                b.MouseButton1Click:Connect(function()
                    if multi then
                        local idx = table.find(selected, item)
                        if idx then table.remove(selected, idx) else table.insert(selected, item) end
                        paintRow(r, item)
                        if flag then NexusLib.Flags[flag] = copySel() end
                        paintDisp()
                        cb(copySel())
                    else
                        selected = item
                        if flag then NexusLib.Flags[flag] = item end
                        paintDisp()
                        cb(item)
                        D:Close()
                    end
                end)
                rowsByItem[item] = r
            end
            return #items
        end
        local function place(count, animate)
            local ap, as = bg.AbsolutePosition, bg.AbsoluteSize
            local w = math.max(as.X, 200)
            local h = panelHeight(count)
            local screenH = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize.Y or 800
            local y = ap.Y + as.Y + 4
            if y + h > screenH - 6 then y = ap.Y - h - 4 end
            local target = UDim2.fromOffset(ap.X + as.X - w, y)
            if animate then Tween(shell, {Size=UDim2.fromOffset(w, h)}, 0.15) else shell.Size = UDim2.fromOffset(w, h) end
            return target
        end
        local popup = {}
        function D:Open()
            if open or NexusLib._destroyed then return end
            RegisterPopup(popup)
            open = true; token = token + 1
            if search then search.Text = "" end
            local count = rebuild()
            local target = place(count, false)
            shell.Position = target - UDim2.fromOffset(0, 6)
            shell.Visible = true
            Tween(shell, {Position=target, BackgroundTransparency=0}, 0.2)
            Tween(pStroke, {Transparency=0}, 0.2)
            Tween(canvas, {GroupTransparency=0}, 0.2)
            Tween(chev, {Rotation=180}, 0.2)
            Tween(hStroke, {Color=th().Accent, Thickness=1.5}, 0.15)
            if follow then follow:Disconnect() end
            follow = RunService.RenderStepped:Connect(function()
                if not open then return end
                if not onScreen(bg) then D:Close(); return end
                local ap, as = bg.AbsolutePosition, bg.AbsoluteSize
                local w = shell.AbsoluteSize.X
                local screenH = workspace.CurrentCamera.ViewportSize.Y
                local h = shell.AbsoluteSize.Y
                local y = ap.Y + as.Y + 4
                if y + h > screenH - 6 then y = ap.Y - h - 4 end
                shell.Position = UDim2.fromOffset(ap.X + as.X - w, y)
            end)
        end
        function D:Close()
            if not open then return end
            open = false; token = token + 1
            local my = token
            UnregisterPopup(popup)
            if follow then follow:Disconnect(); follow = nil end
            if search then pcall(function() search:ReleaseFocus() end) end
            Tween(chev, {Rotation=0}, 0.2)
            Tween(hStroke, {Color=th().Border, Thickness=1}, 0.15)
            local p = shell.Position
            Tween(shell, {Position=p - UDim2.fromOffset(0,6), BackgroundTransparency=1}, 0.14, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            Tween(pStroke, {Transparency=1}, 0.14)
            Tween(canvas, {GroupTransparency=1}, 0.14)
            task.delay(0.15, function() if token == my and not open then shell.Visible = false end end)
        end
        popup.close = function() D:Close() end
        if search then
            search:GetPropertyChangedSignal("Text"):Connect(function()
                if open then place(rebuild(), true) end
            end)
        end
        holder.MouseButton1Click:Connect(function() if open then D:Close() else D:Open() end end)
        local conns = {}
        EC(conns, UserInputService.InputBegan:Connect(function(i)
            if not open or not IsPress(i) then return end
            task.defer(function()
                if not open then return end
                local mp = PointerPos(i)
                local sp, ss = shell.AbsolutePosition, shell.AbsoluteSize
                local hp, hs = holder.AbsolutePosition, holder.AbsoluteSize
                local inP = mp.X >= sp.X and mp.X <= sp.X + ss.X and mp.Y >= sp.Y and mp.Y <= sp.Y + ss.Y
                local inH = mp.X >= hp.X and mp.X <= hp.X + hs.X and mp.Y >= hp.Y and mp.Y <= hp.Y + hs.Y
                if not inP and not inH then D:Close() end
            end)
        end))
        function D:Set(v)
            if multi then
                selected = {}
                if type(v) == "table" then for _, x in ipairs(v) do table.insert(selected, x) end end
            else
                selected = v
            end
            if flag then NexusLib.Flags[flag] = copySel() end
            paintDisp()
            for item, r in pairs(rowsByItem) do paintRow(r, item) end
        end
        function D:Get() return copySel() end
        function D:SetItems(i) itemsSrc = i; if open then place(rebuild(), true) end end
        function D:Refresh()
            if multi then
                local valid = {}
                for _, it in ipairs(getItems()) do valid[it] = true end
                for idx = #selected, 1, -1 do if not valid[selected[idx]] then table.remove(selected, idx) end end
                if flag then NexusLib.Flags[flag] = copySel() end
            end
            paintDisp()
            if open then place(rebuild(), true) end
        end
        function D:SetCallback(f) cb = f end
        function D:IsOpen() return open end
        D._onDestroy = function()
            D:Close()
            if follow then follow:Disconnect() end
            pcall(function() shell:Destroy() end)
        end
        D._cfgGet = function() return copySel() end
        D._cfgSet = function(v) D:Set(v); cb(copySel()) end
        if flag then NexusLib.Options[flag] = D end
        meta(D, "Dropdown", n, n .. " " .. (o.Description or ""), o)
        return finish(row, D, conns)
    end

