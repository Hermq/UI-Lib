            ZIndex=Z+1, LayoutOrder=3, Parent=panel})
        MakeCorner(aHolder, 4)
        local aGrad = Instance.new("UIGradient"); aGrad.Parent = aHolder
        local aCur = MakeFrame({Size=UDim2.new(0,4,1,0), AnchorPoint=Vector2.new(0.5,0),
            BackgroundColor3=Color3.new(1,1,1), ZIndex=Z+2, Parent=aHolder})
        MakeCorner(aCur, 2); MakeStroke(aCur, Color3.new(0,0,0), 1)
        local aLbl = MakeLabel({Size=UDim2.new(0,90,1,0), Position=UDim2.new(1,-94,0,0),
            Text="Opacity 100%", TextSize=11, Font=Enum.Font.GothamBold,
            TextXAlignment=Enum.TextXAlignment.Right, TextColor3=Color3.new(1,1,1),
            TextStrokeTransparency=0.5, ZIndex=Z+3, Parent=aHolder})
        local hexRow = MakeFrame({Size=UDim2.new(1,0,0,26), BackgroundTransparency=1, ZIndex=Z+1, LayoutOrder=4, Parent=panel})
        local hPre = MakeLabel({Size=UDim2.new(0,14,1,0), Text="#", TextSize=13, ZIndex=Z+2, Parent=hexRow})
        R(hPre, "TextColor3", "TextDim")
        local hexBox = Instance.new("TextBox")
        hexBox.Size = UDim2.new(0.55,0,1,0); hexBox.Position = UDim2.new(0,18,0,0)
        hexBox.BorderSizePixel = 0; hexBox.Font = Enum.Font.Code; hexBox.TextSize = 13
        hexBox.Text = ""; hexBox.ClearTextOnFocus = false; hexBox.ZIndex = Z+2; hexBox.Parent = hexRow
        R(hexBox, "BackgroundColor3", "ElementBg"); R(hexBox, "TextColor3", "TextPrimary")
        MakeCorner(hexBox, 4)

        local function visuals()
            svHolder.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
            svCur.Position = UDim2.new(math.clamp(s,0,1), 0, 1 - math.clamp(v,0,1), 0)
            hCur.Position = UDim2.new(h, 0, 0, 0)
            aCur.Position = UDim2.new(alpha, 0, 0, 0)
            clr = Color3.fromHSV(h, s, v)
            prev.BackgroundColor3 = clr; prev.BackgroundTransparency = 1 - alpha
            if not hexBox:IsFocused() then hexBox.Text = clr:ToHex():upper() end
            aLbl.Text = ("Opacity %d%%"):format(math.round(alpha * 100))
            aGrad.Color = ColorSequence.new(Color3.fromRGB(40,40,40), clr)
            if flag then NexusLib.Flags[flag] = clr end
        end
        local function changed() visuals(); cb(clr, alpha) end
        visuals()

        local conns = {}
        local dragging = nil
        local function handle(pos)
            if dragging == "sv" then
                local ap, as = svHolder.AbsolutePosition, svHolder.AbsoluteSize
                s = math.clamp((pos.X - ap.X) / math.max(as.X,1), 0, 1)
                v = 1 - math.clamp((pos.Y - ap.Y) / math.max(as.Y,1), 0, 1)
            elseif dragging == "h" then
                h = math.clamp((pos.X - hueHolder.AbsolutePosition.X) / math.max(hueHolder.AbsoluteSize.X,1), 0, 1)
            elseif dragging == "a" then
                alpha = math.clamp((pos.X - aHolder.AbsolutePosition.X) / math.max(aHolder.AbsoluteSize.X,1), 0, 1)
            end
            changed()
        end
        local function hook(frame, key)
            local hit = MakeButton({Size=UDim2.fromScale(1,1), BackgroundTransparency=1, ZIndex=Z+6, Parent=frame})
            hit.InputBegan:Connect(function(i)
                if IsPress(i) then dragging = key; handle(PointerPos(i)) end
            end)
        end
        hook(svHolder, "sv"); hook(hueHolder, "h"); hook(aHolder, "a")
        EC(conns, UserInputService.InputChanged:Connect(function(i)
            if dragging and IsMove(i) then handle(PointerPos(i)) end
        end))
        EC(conns, UserInputService.InputEnded:Connect(function(i)
            if IsPress(i) then dragging = nil end
        end))
        hexBox.FocusLost:Connect(function()
            local hex = hexBox.Text:gsub("#", ""):gsub("[^%x]", "")
            if #hex == 6 then
                local nc = Color3.fromRGB(tonumber(hex:sub(1,2),16), tonumber(hex:sub(3,4),16), tonumber(hex:sub(5,6),16))
                h, s, v = Color3.toHSV(nc); changed()
            else visuals() end
        end)
        local col = Collapsible(clip, function() return pll.AbsoluteContentSize.Y + 16 + 4 end, nil, false)
        pll:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() col:Follow() end)
        prev.MouseButton1Click:Connect(function()
            task.spawn(function() col:Animate(not col.expanded, 0.28) end)
        end)
        local Cp = {}
        function Cp:Set(c, a)
            if typeof(c) == "Color3" then h, s, v = Color3.toHSV(c) end
            if a ~= nil then alpha = math.clamp(a, 0, 1) end
            visuals()
        end
        function Cp:Get() return clr end
        function Cp:GetAlpha() return alpha end
        function Cp:SetCallback(f) cb = f end
        if flag then NexusLib.Options[flag] = Cp end
        return finish(row, Cp, conns)
    end

    -- ── CREDIT ──────────────────────────────────────────
    function obj:AddCredit(o)
        o = o or {}
        local row = newRow(44)
        local bg = newBg(row, 40)
        local nl = MakeLabel({Size=UDim2.new(1,-20,0,20), Position=UDim2.new(0,10,0,4),
            Text=o.Name or "Author", Font=Enum.Font.GothamBold, TextSize=13,
            TextXAlignment=Enum.TextXAlignment.Left, ZIndex=Z+1, Parent=bg})
        R(nl, "TextColor3", "TextPrimary")
        local dl = MakeLabel({Size=UDim2.new(1,-20,0,14), Position=UDim2.new(0,10,0,23),
            Text=o.Description or "", TextSize=11,
            TextXAlignment=Enum.TextXAlignment.Left, ZIndex=Z+1, Parent=bg})
        R(dl, "TextColor3", "TextDim")
        return finish(row, {}, {})
    end

    -- ── ACCORDION (infinite nesting) ────────────────────
    function obj:AddAccordion(o)
        return NexusLib._makeAccordion(container, ctx, (o and o.Name) or "Group", (ctx.depth or 0) + (ctx.isAccordion and 1 or 0))
    end
end

function NexusLib._makeAccordion(parentContainer, parentCtx, name, depth)
    depth = depth or 0
    local th, R, RF = parentCtx.theme, parentCtx.R, parentCtx.RF
    local HDR_H  = math.max(36 - depth * 3, 28)
    local BAR_W  = math.max(4 - depth, 2)
    local FSIZE  = math.max(13 - depth, 11)
    local PAD_V  = math.max(7 - depth * 2, 3)
    local PAD_H  = math.max(6 - depth, 2)
    local hdrKey = depth == 0 and "SecondaryBg" or "TertiaryBg"
    local inset  = parentCtx.inset or 8
    local Z = 12 + depth * 2

    local row = MakeFrame({Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
        BackgroundTransparency=1, ZIndex=Z})
    row.LayoutOrder = parentCtx.order()
    local header = MakeButton({Size=UDim2.new(1,-2*inset,0,HDR_H), Position=UDim2.new(0,inset,0,0), ZIndex=Z+1, Parent=row})
    header.BackgroundColor3 = th()[hdrKey]
    MakeCorner(header, math.max(8 - depth * 2, 4))
    local acBar = MakeFrame({Size=UDim2.new(0,BAR_W,1,-math.floor(HDR_H*0.4)),
        Position=UDim2.new(0,0,0,math.floor(HDR_H*0.2)), ZIndex=Z+2, Parent=header})
    MakeCorner(acBar, 3)
    local nameLbl = MakeLabel({Size=UDim2.new(1,-44,1,0), Position=UDim2.new(0,BAR_W+8,0,0),
        Text=name, Font=depth == 0 and Enum.Font.GothamBold or Enum.Font.Gotham, TextSize=FSIZE,
        TextXAlignment=Enum.TextXAlignment.Left, ZIndex=Z+2, Parent=header})
    local chev = Icons.Chevron(header, th().TextDim, Z+2)
    chev.Position = UDim2.new(1,-16,0.5,0); chev.Rotation = -90
    local clip = MakeFrame({Size=UDim2.new(1,0,0,0), Position=UDim2.new(0,0,0,HDR_H+2),
        BackgroundTransparency=1, ClipsDescendants=true, ZIndex=Z, Parent=row})
    local inner = MakeFrame({Size=UDim2.new(1,-2*inset,0,0), Position=UDim2.new(0,inset,0,0),
        AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, ZIndex=Z, Parent=clip})
    local ll = Instance.new("UIListLayout"); ll.SortOrder = Enum.SortOrder.LayoutOrder
    ll.Padding = UDim.new(0, math.max(5 - depth, 2)); ll.Parent = inner
    local pd = Instance.new("UIPadding")
    pd.PaddingTop = UDim.new(0,PAD_V); pd.PaddingBottom = UDim.new(0,PAD_V)
    pd.PaddingLeft = UDim.new(0,PAD_H); pd.PaddingRight = UDim.new(0,PAD_H); pd.Parent = inner

    local col = Collapsible(clip, function() return ll.AbsoluteContentSize.Y + PAD_V * 2 end, nil, false)
    ll:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() col:Follow() end)
    local function paint()
        local t = th()
        header.BackgroundColor3 = col.expanded and t.ElementHover or t[hdrKey]
        acBar.BackgroundColor3 = col.expanded and t.AccentBar or t.Accent
        nameLbl.TextColor3 = depth == 0 and t.TextPrimary or t.TextSecondary
        PaintIcon(chev, t.TextDim)
    end
    paint(); RF(paint)
    local function setExpanded(e)
        Tween(chev, {Rotation = e and 0 or -90}, 0.2)
        Tween(header, {BackgroundColor3 = e and th().ElementHover or th()[hdrKey]}, 0.12)
        acBar.BackgroundColor3 = e and th().AccentBar or th().Accent
        task.spawn(function() col:Animate(e, 0.28) end)
    end
    header.MouseButton1Click:Connect(function() setExpanded(not col.expanded) end)
    header.MouseEnter:Connect(function()
        if not col.expanded then Tween(header, {BackgroundColor3=th().ElementHover}, 0.1) end
    end)
    header.MouseLeave:Connect(function()
        if not col.expanded then Tween(header, {BackgroundColor3=th()[hdrKey]}, 0.1) end
    end)
    row.Parent = parentContainer

    local Acc = {_row = row, _inner = inner}
    local childCtx = {theme = th, R = R, RF = RF, inset = 0, order = Counter(),
        depth = depth, isAccordion = true, sepBg = depth == 0 and "Background" or "SecondaryBg"}
    AttachElements(Acc, inner, childCtx)
    function Acc:AddAccordion(o)
        return NexusLib._makeAccordion(inner, childCtx, (o and o.Name) or "Group", depth + 1)
    end
    function Acc:Expand() setExpanded(true) end
    function Acc:Collapse() setExpanded(false) end
    function Acc:SetName(t) nameLbl.Text = tostring(t) end
    function Acc:SetVisible(v) row.Visible = v and true or false end
    function Acc._cleanup()
        for _, el in ipairs(childCtx.elements or {}) do pcall(el._cleanup) end
    end
    function Acc:Destroy()
        Acc._cleanup()
        local i = parentCtx.elements and table.find(parentCtx.elements, Acc)
        if i then table.remove(parentCtx.elements, i) end
        pcall(function() row:Destroy() end)
    end
    parentCtx.elements = parentCtx.elements or {}
    table.insert(parentCtx.elements, Acc)
    Acc._remeasure = function() col:Follow() end
    return Acc
end

-- ═══════════════════════════════════════════════════════════
--  CreateWindow
-- ═══════════════════════════════════════════════════════════
function NexusLib:CreateWindow(opts)
    opts = opts or {}
    local theme = opts.Theme
    if type(theme) == "string" then theme = self.Themes[theme] or self._theme
    elseif type(theme) ~= "table" then theme = self._theme end
    self._theme = theme

    local winName   = opts.Name or "Script"
    local winW      = (opts.Size and opts.Size.X) or 580
    local winH      = (opts.Size and opts.Size.Y) or 400
    local toggleKey = opts.ToggleKey
    local statusTxt = opts.Status or ""
    local bgUrl     = opts.CustomBackground
    local destroyOnClose = opts.DestroyOnClose ~= false
    local TBAR, SBAR, TABW = 40, 22, 130

    local Win = {_theme = theme, _tabs = {}, _minimized = false, _closeCbs = {}, _conns = {}}
    local function th() return Win._theme end
    local _refs, _fns = {}, {}
    local function R(obj, prop, key)
        table.insert(_refs, {obj, prop, key})
        pcall(function() obj[prop] = Win._theme[key] end)
    end
    local function RF(fn) table.insert(_fns, fn) end
    Win._refs = _refs
    local function WC(c) table.insert(Win._conns, c); AddConn(c); return c end
    if type(opts.OnClose) == "function" then table.insert(Win._closeCbs, opts.OnClose) end

    local mainFrame = MakeFrame({Name="NexusWindow", Size=UDim2.fromOffset(winW, winH),
        Position=UDim2.new(0.5,-winW/2,0.5,-winH/2), ZIndex=10, ClipsDescendants=true,
        BackgroundTransparency=1, Parent=gui})
    R(mainFrame, "BackgroundColor3", "Background"); MakeCorner(mainFrame, 10)
    local winStroke = MakeStroke(mainFrame, th().Border, 1)
    RF(function() winStroke.Color = th().Border end)
    local winScale = Instance.new("UIScale"); winScale.Name = "WindowScale"; winScale.Scale = 0.94
    winScale.Parent = mainFrame
    Win._frame = mainFrame; Win._scale = winScale

    local bgImage = nil
    local function makeBgImage(url)
        bgImage = Instance.new("ImageLabel")
        bgImage.Size = UDim2.fromScale(1,1); bgImage.BackgroundTransparency = 1
        bgImage.Image = url; bgImage.ImageTransparency = 0.65
        bgImage.ScaleType = Enum.ScaleType.Crop; bgImage.ZIndex = 10; bgImage.Parent = mainFrame
        MakeCorner(bgImage, 10)
    end
    if type(bgUrl) == "string" and bgUrl ~= "" then makeBgImage(bgUrl) end

    TweenSpring(winScale, {Scale=1}, 0.45)
    Tween(mainFrame, {BackgroundTransparency=0}, 0.3)

    -- Title bar
    local tbar = MakeFrame({Name="TitleBar", Size=UDim2.new(1,0,0,TBAR), ZIndex=11, Parent=mainFrame})
    R(tbar, "BackgroundColor3", "SecondaryBg"); MakeCorner(tbar, 10)
    local tbarPatch = MakeFrame({Size=UDim2.new(1,0,0,12), Position=UDim2.new(0,0,1,-12), ZIndex=11, Parent=tbar})
    R(tbarPatch, "BackgroundColor3", "SecondaryBg")
    local accentLine = MakeFrame({Size=UDim2.new(1,0,0,2), Position=UDim2.new(0,0,1,-1), ZIndex=12, Parent=tbar})
    R(accentLine, "BackgroundColor3", "Accent")
    local statusDot = MakeFrame({Size=UDim2.fromOffset(7,7), Position=UDim2.new(0,12,0.5,-3), ZIndex=13, Parent=tbar})
    MakeCorner(statusDot, 4)
    local dotColor = nil
    local function paintDot() statusDot.BackgroundColor3 = dotColor or th().TextDim end
    paintDot(); RF(paintDot)
    local titleLbl = MakeLabel({Size=UDim2.new(1,-110,1,0), Position=UDim2.new(0,26,0,0),
        Text=winName, Font=Enum.Font.GothamBold, TextSize=14, ZIndex=12,
        TextXAlignment=Enum.TextXAlignment.Left, TextTruncate=Enum.TextTruncate.AtEnd, Parent=tbar})
    R(titleLbl, "TextColor3", "TextPrimary")

    local minBtn = MakeButton({Name="MinimizeButton", Size=UDim2.fromOffset(28,28),
        Position=UDim2.new(1,-66,0.5,-14), ZIndex=13, Parent=tbar})
    R(minBtn, "BackgroundColor3", "TertiaryBg"); MakeCorner(minBtn, 6)
    local minIcon = Icons.Minus(minBtn, 12, 2, th().TextSecondary, 14)
    RF(function() PaintIcon(minIcon, th().TextSecondary) end)
    local closeBtn = MakeButton({Name="CloseButton", Size=UDim2.fromOffset(28,28),
        Position=UDim2.new(1,-34,0.5,-14), BackgroundColor3=Color3.fromRGB(180,50,50), ZIndex=13, Parent=tbar})
    MakeCorner(closeBtn, 6)
    Icons.X(closeBtn, 13, 2, Color3.new(1,1,1), 14)
    minBtn.MouseEnter:Connect(function() Tween(minBtn, {BackgroundColor3=th().ElementHover}, 0.1) end)
    minBtn.MouseLeave:Connect(function() Tween(minBtn, {BackgroundColor3=th().TertiaryBg}, 0.1) end)
    closeBtn.MouseEnter:Connect(function() Tween(closeBtn, {BackgroundColor3=Color3.fromRGB(220,70,70)}, 0.1) end)
    closeBtn.MouseLeave:Connect(function() Tween(closeBtn, {BackgroundColor3=Color3.fromRGB(180,50,50)}, 0.1) end)
    AddPressScale(minBtn); AddPressScale(closeBtn)

    local body = MakeFrame({Name="Body", Size=UDim2.new(1,0,0,winH-TBAR-SBAR),
        Position=UDim2.new(0,0,0,TBAR), ZIndex=10, ClipsDescendants=true, Parent=mainFrame})
    R(body, "BackgroundColor3", "Background")
    if bgImage then body.BackgroundTransparency = 1 end
    local sbar = MakeFrame({Name="StatusBar", Size=UDim2.new(1,0,0,SBAR),
        Position=UDim2.new(0,0,1,-SBAR), ZIndex=11, Parent=mainFrame})
    R(sbar, "BackgroundColor3", "SecondaryBg")
    local sbarBorder = MakeFrame({Size=UDim2.new(1,0,0,1), ZIndex=12, Parent=sbar})
    R(sbarBorder, "BackgroundColor3", "Border")
    local sbarLbl = MakeLabel({Size=UDim2.new(1,-20,1,0), Position=UDim2.new(0,10,0,0),
        Text=statusTxt, TextSize=11, ZIndex=12, TextXAlignment=Enum.TextXAlignment.Left,
        TextTruncate=Enum.TextTruncate.AtEnd, Parent=sbar})
    R(sbarLbl, "TextColor3", "TextDim")

    local sidebar = MakeFrame({Name="Sidebar", Size=UDim2.new(0,TABW,1,0), ZIndex=11, Parent=body})
    R(sidebar, "BackgroundColor3", "SecondaryBg")
    if bgImage then sidebar.BackgroundTransparency = 0.12 end
    local tabLL = Instance.new("UIListLayout"); tabLL.SortOrder = Enum.SortOrder.LayoutOrder
    tabLL.Padding = UDim.new(0,3); tabLL.Parent = sidebar
    local tabPd = Instance.new("UIPadding"); tabPd.PaddingTop = UDim.new(0,8)
    tabPd.PaddingLeft = UDim.new(0,6); tabPd.PaddingRight = UDim.new(0,6); tabPd.Parent = sidebar
    local pageHolder = MakeFrame({Name="Pages", Size=UDim2.new(1,-TABW,1,0),
        Position=UDim2.new(0,TABW,0,0), BackgroundTransparency=1, ZIndex=10,
        ClipsDescendants=true, Parent=body})

    -- Dragging (mouse + touch), kept on-screen
    local dragging, dragStart, startPos, dragInput = false, nil, nil, nil
    tbar.InputBegan:Connect(function(i)
        if IsPress(i) then
            dragging = true; dragInput = i; dragStart = PointerPos(i); startPos = mainFrame.Position
            NexusLib:ClosePopups()
        end
    end)
    WC(UserInputService.InputChanged:Connect(function(i)
        if not dragging or not IsMove(i) then return end
        if i.UserInputType == Enum.UserInputType.Touch and dragInput and dragInput.UserInputType == Enum.UserInputType.Touch and i ~= dragInput then return end
        local d = PointerPos(i) - dragStart
        local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920,1080)
        local nx = startPos.X.Offset + d.X
        local ny = startPos.Y.Offset + d.Y
        -- keep at least 60px of the title bar reachable
        local absX = startPos.X.Scale * vp.X + nx
        local absY = startPos.Y.Scale * vp.Y + ny
        absX = math.clamp(absX, 60 - winW, vp.X - 60)
        absY = math.clamp(absY, 0, vp.Y - TBAR)
        mainFrame.Position = UDim2.new(startPos.X.Scale, absX - startPos.X.Scale * vp.X,
            startPos.Y.Scale, absY - startPos.Y.Scale * vp.Y)
    end))
    WC(UserInputService.InputEnded:Connect(function(i)
        if IsPress(i) then dragging = false; dragInput = nil end
    end))

    -- Minimize
    local minBusy = false
    minBtn.MouseButton1Click:Connect(function()
        if minBusy then return end
        minBusy = true
        NexusLib:ClosePopups()
        Win._minimized = not Win._minimized
        if Win._minimized then
            body.Visible = false; sbar.Visible = false
            Tween(mainFrame, {Size=UDim2.fromOffset(winW, TBAR)}, 0.22, Enum.EasingStyle.Quart)
            task.delay(0.22, function() minBusy = false end)
        else
            Tween(mainFrame, {Size=UDim2.fromOffset(winW, winH)}, 0.24, Enum.EasingStyle.Quart)
            task.delay(0.2, function() sbar.Visible = true; body.Visible = true; minBusy = false end)
        end
    end)

    -- Close: runs OnClose callbacks, animates out, then tears down
    local closing = false
    function Win:Close()
        if closing then return end
        closing = true
        NexusLib:ClosePopups()
        for _, fn in ipairs(Win._closeCbs) do
            local ok, err = pcall(fn)
            if not ok then warn("[NexusLib] OnClose error: " .. tostring(err)) end
        end
        Tween(winScale, {Scale=0.86}, 0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        Tween(mainFrame, {BackgroundTransparency=1}, 0.22)
        Tween(winStroke, {Transparency=1}, 0.22)
        task.delay(0.24, function()
            if destroyOnClose then NexusLib:Destroy() else Win:Destroy() end
        end)
    end
    closeBtn.MouseButton1Click:Connect(function() Win:Close() end)
    -- Window destroyed any other way: still run close callbacks once
    mainFrame.Destroying:Connect(function()
        if not closing then
            closing = true
            for _, fn in ipairs(Win._closeCbs) do pcall(fn) end
        end
    end)

    if toggleKey then
        WC(UserInputService.InputBegan:Connect(function(i, gp)
            if NexusLib._listening then return end
            if not gp and i.UserInputType == Enum.UserInputType.Keyboard and i.KeyCode == toggleKey then
                Win:ToggleVisible()
            end
        end))
    end

    -- ── Win methods ──────────────────────────────────────
    local visBusy = false
    function Win:SetVisible(v)
        if not mainFrame.Parent or visBusy then return end
        if v == mainFrame.Visible then return end
        visBusy = true
        if not v then
            NexusLib:ClosePopups()
            Tween(winScale, {Scale=0.88}, 0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            task.delay(0.16, function() mainFrame.Visible = false; winScale.Scale = 1; visBusy = false end)
        else
            winScale.Scale = 0.88; mainFrame.Visible = true
            TweenSpring(winScale, {Scale=1}, 0.3)
            task.delay(0.3, function() visBusy = false end)
        end
    end
    function Win:ToggleVisible() Win:SetVisible(not mainFrame.Visible) end
    function Win:IsVisible() return mainFrame.Visible end
    function Win:OnClose(fn) if type(fn) == "function" then table.insert(Win._closeCbs, fn) end end
    function Win:SetTitle(t) titleLbl.Text = tostring(t) end
    function Win:SetStatus(text, color)
        sbarLbl.Text = text or ""
        if color then dotColor = color; Tween(statusDot, {BackgroundColor3=color}, 0.2) end
    end
    function Win:SetTheme(t)
        local nt = type(t) == "string" and NexusLib.Themes[t] or t
        if type(nt) ~= "table" then return end
        Win._theme = nt; NexusLib._theme = nt
        for _, r in ipairs(_refs) do pcall(function() r[1][r[2]] = nt[r[3]] end) end
        for _, fn in ipairs(_fns) do pcall(fn) end
        for _, tb in ipairs(Win._tabs) do pcall(tb._paint) end
    end
    function Win:SetBackground(url)
        url = (url or ""):match("^%s*(.-)%s*$")
        if url ~= "" then
            if url:match("^%d+$") then url = "rbxassetid://" .. url end
            if url:match("^https?://") then
                warn("[NexusLib] SetBackground: use rbxassetid://, not HTTP URLs"); url = ""
            end
        end
        if bgImage then bgImage.Image = url
        elseif url ~= "" then makeBgImage(url) end
        body.BackgroundTransparency = (url ~= "") and 1 or 0
        sidebar.BackgroundTransparency = (url ~= "") and 0.12 or 0
    end
    function Win:Destroy()
        for _, c in ipairs(Win._conns) do pcall(function() c:Disconnect() end) end
        Win._conns = {}
        if mainFrame and mainFrame.Parent then pcall(function() mainFrame:Destroy() end) end
    end
    function Win:SelectTab(name)
        for _, tb in ipairs(Win._tabs) do if tb._name == name then tb:Select() return true end end
        return false
    end

    -- ════════════════════════════════════════════════════
    --  AddTab
    -- ════════════════════════════════════════════════════
    function Win:AddTab(topts)
        topts = topts or {}
        local tName = topts.Name or "Tab"
        local tIcon = topts.Icon
        local tbtn = MakeButton({Name="TBtn_" .. tName, Size=UDim2.new(1,0,0,34),
            BackgroundTransparency=1, LayoutOrder=#Win._tabs + 1, ZIndex=12, Parent=sidebar})
        MakeCorner(tbtn, 6)
        local lx = 14
        if tIcon then
            local img = Instance.new("ImageLabel")
            img.Size = UDim2.fromOffset(16,16); img.Position = UDim2.new(0,12,0.5,-8)
            img.BackgroundTransparency = 1; img.Image = tIcon; img.ZIndex = 13; img.Parent = tbtn
            lx = 34
        end
        local tabLbl = MakeLabel({Size=UDim2.new(1,-lx-6,1,0), Position=UDim2.new(0,lx,0,0), Text=tName,
            TextSize=13, TextXAlignment=Enum.TextXAlignment.Left, TextTruncate=Enum.TextTruncate.AtEnd,
            ZIndex=13, Parent=tbtn})
        local acBar = MakeFrame({Name="AccentBar", AnchorPoint=Vector2.new(0,0.5), Size=UDim2.new(0,4,0,0),
            Position=UDim2.new(0,0,0.5,0), ZIndex=13, Parent=tbtn})
        MakeCorner(acBar, 3)

        local pageWrap = MakeFrame({Name="PW_" .. tName, Size=UDim2.fromScale(1,1),
            BackgroundTransparency=1, Visible=false, ZIndex=11, Parent=pageHolder})
        local page = Instance.new("ScrollingFrame")
        page.Name = "Pg_" .. tName; page.Size = UDim2.fromScale(1,1)
        page.BackgroundTransparency = 1; page.BorderSizePixel = 0; page.ScrollBarThickness = 3
        page.CanvasSize = UDim2.new(); page.AutomaticCanvasSize = Enum.AutomaticSize.Y
        page.ScrollingDirection = Enum.ScrollingDirection.Y
        page.ZIndex = 11; page.ClipsDescendants = true; page.Parent = pageWrap
        R(page, "ScrollBarImageColor3", "ScrollBar")
        local pgLL = Instance.new("UIListLayout"); pgLL.SortOrder = Enum.SortOrder.LayoutOrder
        pgLL.Padding = UDim.new(0,6); pgLL.Parent = page
        local pgPd = Instance.new("UIPadding")
        pgPd.PaddingTop = UDim.new(0,8); pgPd.PaddingLeft = UDim.new(0,8)
        pgPd.PaddingRight = UDim.new(0,10); pgPd.PaddingBottom = UDim.new(0,8); pgPd.Parent = page
        page:GetPropertyChangedSignal("CanvasPosition"):Connect(function() NexusLib:ClosePopups() end)

        local Tab = {_page=page, _wrap=pageWrap, _btn=tbtn, _acBar=acBar, _lbl=tabLbl, _name=tName}
        local order = Counter()
        local function paint(sel, animate)
            local t = th()
            local d = animate and 0.15 or 0
            Tween(tbtn, {BackgroundTransparency = sel and 0 or 1, BackgroundColor3 = t.ElementBg}, d)
            Tween(tabLbl, {TextColor3 = sel and t.TextPrimary or t.TextDim}, d)
            acBar.BackgroundColor3 = t.AccentBar
            Tween(acBar, {Size = UDim2.new(0,4,0, sel and 20 or 0)}, animate and 0.25 or 0)
        end
        Tab._paint = function() paint(Win._selected == Tab, false) end
        paint(false, false)
        function Tab:Select()
            if Win._selected == Tab then return end
            NexusLib:ClosePopups()
            for _, t in ipairs(Win._tabs) do
                if t ~= Tab then t._wrap.Visible = false; t._setSel(false) end
            end
            Win._selected = Tab
            pageWrap.Visible = true
            page.Position = UDim2.fromOffset(0, 10)
            Tween(page, {Position = UDim2.new()}, 0.28)
            paint(true, true)
        end
        Tab._setSel = function(v) paint(v, true) end
        tbtn.MouseButton1Click:Connect(function() Tab:Select() end)
        tbtn.MouseEnter:Connect(function()
            if Win._selected ~= Tab then Tween(tbtn, {BackgroundTransparency=0.6, BackgroundColor3=th().ElementBg}, 0.1) end
        end)
        tbtn.MouseLeave:Connect(function()
            if Win._selected ~= Tab then Tween(tbtn, {BackgroundTransparency=1}, 0.1) end
        end)
        table.insert(Win._tabs, Tab)
        if #Win._tabs == 1 then Tab:Select() end

        -- ── AddSection ──────────────────────────────────
        function Tab:AddSection(sopts)
            sopts = sopts or {}
            local sName = sopts.Name or "Section"
            local HDR_H = 30
            local CLIP_TOP = HDR_H + 1
            local sec = MakeFrame({Name="S_" .. sName, Size=UDim2.new(1,0,0,HDR_H), ZIndex=12, Parent=page})
            sec.LayoutOrder = order()
            R(sec, "BackgroundColor3", "SecondaryBg"); MakeCorner(sec, 8)
            local hdrBtn = MakeButton({Size=UDim2.new(1,0,0,HDR_H), BackgroundTransparency=1, ZIndex=13, Parent=sec})
            local secHdr = MakeLabel({Size=UDim2.new(1,-40,0,HDR_H), Position=UDim2.new(0,12,0,0),
                Text=sName, Font=Enum.Font.GothamBold, TextSize=12,
                TextXAlignment=Enum.TextXAlignment.Left, TextTruncate=Enum.TextTruncate.AtEnd,
                ZIndex=14, Parent=hdrBtn})
            R(secHdr, "TextColor3", "Accent")
            local chev = Icons.Chevron(hdrBtn, th().TextDim, 14)
            chev.Position = UDim2.new(1,-18,0.5,0)
            RF(function() PaintIcon(chev, th().TextDim) end)
            local secDiv = MakeFrame({Size=UDim2.new(1,-20,0,1), Position=UDim2.new(0,10,0,HDR_H-1), ZIndex=13, Parent=sec})
            R(secDiv, "BackgroundColor3", "Border")
            local secClip = MakeFrame({Size=UDim2.new(1,0,0,0), Position=UDim2.new(0,0,0,CLIP_TOP),
                BackgroundTransparency=1, ClipsDescendants=true, ZIndex=12, Parent=sec})
            local elems = MakeFrame({Name="Elems", Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
                BackgroundTransparency=1, ZIndex=13, Parent=secClip})
            local eLL = Instance.new("UIListLayout"); eLL.SortOrder = Enum.SortOrder.LayoutOrder; eLL.Parent = elems
            local ePd = Instance.new("UIPadding"); ePd.PaddingTop = UDim.new(0,4); ePd.PaddingBottom = UDim.new(0,6); ePd.Parent = elems

            local col = Collapsible(secClip,
                function() return eLL.AbsoluteContentSize.Y + 10 end,
                function(h)
                    sec.Size = UDim2.new(1,0,0, (h > 0.5) and (CLIP_TOP + h) or HDR_H)
                    secDiv.Visible = h > 0.5
                end,
                not sopts.Collapsed)
            chev.Rotation = col.expanded and 0 or -90
            col:Snap()
            eLL:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() col:Follow() end)
            local function setExpanded(e)
                Tween(chev, {Rotation = e and 0 or -90}, 0.22)
                task.spawn(function() col:Animate(e, 0.3) end)
            end
            hdrBtn.MouseButton1Click:Connect(function() setExpanded(not col.expanded) end)
            hdrBtn.MouseEnter:Connect(function() Tween(chev, {Size=UDim2.fromOffset(16,16)}, 0.1) end)
            hdrBtn.MouseLeave:Connect(function() Tween(chev, {Size=UDim2.fromOffset(14,14)}, 0.1) end)

            local Sec = {_frame=sec, _elems=elems, _header=secHdr}
            local secCtx = {theme=th, R=R, RF=RF, inset=8, order=Counter(), depth=0, elements={}}
            AttachElements(Sec, elems, secCtx)

            function Sec:SetName(newName)
                secHdr.Text = tostring(newName)
                sec.Name = "S_" .. tostring(newName)
            end
            function Sec:GetName() return secHdr.Text end
            function Sec:Expand() setExpanded(true) end
            function Sec:Collapse() setExpanded(false) end
            function Sec:SetCollapsed(c) setExpanded(not c) end
            function Sec:IsCollapsed() return not col.expanded end
            function Sec:SetVisible(v) sec.Visible = v and true or false end
            function Sec:Destroy(instant)
                for _, el in ipairs(secCtx.elements) do pcall(el._cleanup) end
                sec.Name = "S__removing"
                if instant then pcall(function() sec:Destroy() end); return end
                col.token = col.token + 1
                sec.ClipsDescendants = true
                local tw = Tween(sec, {Size=UDim2.new(1,0,0,0), BackgroundTransparency=1}, 0.25,
                    Enum.EasingStyle.Quint, Enum.EasingDirection.In)
                if tw then tw.Completed:Once(function() pcall(function() sec:Destroy() end) end)
                else pcall(function() sec:Destroy() end) end
            end
            -- Click the section title to rename it. cb(newName, oldName) may
            -- return false to reject the change.
            function Sec:EnableRename(cb)
                local overlay = MakeButton({BackgroundTransparency=1, ZIndex=16, Parent=hdrBtn,
                    Position=UDim2.new(0,8,0,4), Size=UDim2.new(0,40,0,HDR_H-8)})
                local function fit()
                    overlay.Size = UDim2.new(0, math.max(secHdr.TextBounds.X + 8, 40), 0, HDR_H - 8)
                end
                fit(); secHdr:GetPropertyChangedSignal("TextBounds"):Connect(fit)
                overlay.MouseEnter:Connect(function() Tween(secHdr, {TextColor3=th().AccentHover}, 0.1) end)
                overlay.MouseLeave:Connect(function() Tween(secHdr, {TextColor3=th().Accent}, 0.1) end)
                overlay.MouseButton1Click:Connect(function()
                    local old = secHdr.Text
                    secHdr.Visible = false; overlay.Visible = false
                    local inp = Instance.new("TextBox")
                    inp.Size = UDim2.new(0,190,0,22); inp.Position = UDim2.new(0,8,0.5,-11)
                    inp.BorderSizePixel = 0; inp.Font = Enum.Font.GothamBold; inp.TextSize = 12
                    inp.Text = old; inp.ClearTextOnFocus = false; inp.ZIndex = 17
                    inp.TextXAlignment = Enum.TextXAlignment.Left
                    inp.BackgroundColor3 = th().ElementBg; inp.TextColor3 = th().Accent
                    MakeCorner(inp, 5); MakeStroke(inp, th().Accent, 1).Transparency = 0.4
                    local ip = Instance.new("UIPadding"); ip.PaddingLeft = UDim.new(0,6); ip.Parent = inp
                    inp.Parent = hdrBtn
                    inp:CaptureFocus()
                    inp.FocusLost:Connect(function()
                        local new = inp.Text
                        inp:Destroy(); secHdr.Visible = true; overlay.Visible = true
                        if new == "" or new == old then return end
                        local accept = true
                        if cb then
                            local ok, r = pcall(cb, new, old)
                            if ok and r == false then accept = false end
                        end
                        if accept then Sec:SetName(new) end
                    end)
                end)
            end
            return Sec
        end

        function Tab:AddAccordion(o)
            return NexusLib._makeAccordion(page, {theme=th, R=R, RF=RF, inset=0, order=order, depth=0},
                (o and o.Name) or "Group", 0)
        end
        return Tab
    end

    return Win
end

return NexusLib
