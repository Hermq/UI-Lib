-- ── Tween helpers ─────────────────────────────────────────
local function Tween(obj, props, t, style, dir)
    local ok, tw = pcall(function()
        return TweenService:Create(obj,
            TweenInfo.new(t or 0.15,
                style or Enum.EasingStyle.Quint,
                dir   or Enum.EasingDirection.Out),
            props)
    end)
    if ok and tw then tw:Play(); return tw end
    return nil
end
local function TweenSpring(obj, props, t)
    return Tween(obj, props, t or 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end
local function TweenSine(obj, props, t)
    return Tween(obj, props, t or 0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
end

local function AddConn(c) table.insert(NexusLib.Connections, c); return c end

local function IsPress(i)
    return i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch
end
local function IsMove(i)
    return i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch
end
-- Pointer position in the same space as the window's AbsolutePosition. GetMouseLocation includes the
-- top bar; the window's coordinates only do if the ScreenGui really ignores the inset (not always the
-- case inside executor containers) - the gap between the viewport and the ScreenGui's size says which.
local function PointerPos(i)
    local inset = Vector2.new(0, 0)
    pcall(function() inset = game:GetService("GuiService"):GetGuiInset() end)
    local screen
    if i and i.UserInputType == Enum.UserInputType.Touch then
        screen = Vector2.new(i.Position.X, i.Position.Y) + inset   -- touch positions exclude the inset
    else
        screen = UserInputService:GetMouseLocation()
    end
    local g = NexusLib._rootGui
    local offY = 0
    pcall(function()
        local cam = workspace.CurrentCamera
        if g and g.Parent and cam then
            local gap = cam.ViewportSize.Y - g.AbsoluteSize.Y
            if gap > 1 and gap < 120 then offY = gap end
        end
    end)
    return Vector2.new(screen.X, screen.Y - offY)
end

-- ── Instance helpers ──────────────────────────────────────
local function MakeCorner(p, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 8); c.Parent = p; return c
end
local function MakeStroke(p, col, thick)
    local s = Instance.new("UIStroke"); s.Color = col or Color3.fromRGB(60,60,80)
    s.Thickness = thick or 1; s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = p; return s
end
local function MakeFrame(props)
    local f = Instance.new("Frame"); f.BorderSizePixel = 0
    for k, v in pairs(props) do pcall(function() f[k] = v end) end
    return f
end
local function MakeLabel(props)
    local l = Instance.new("TextLabel"); l.BackgroundTransparency = 1
    l.BorderSizePixel = 0; l.Font = Enum.Font.Gotham
    for k, v in pairs(props) do pcall(function() l[k] = v end) end
    return l
end
local function MakeButton(props)
    local b = Instance.new("TextButton"); b.BorderSizePixel = 0
    b.AutoButtonColor = false; b.Text = ""; b.Font = Enum.Font.Gotham
    for k, v in pairs(props) do pcall(function() b[k] = v end) end
    return b
end

-- ── Drawn icons (glyphs like × − ◀ render as squares) ─────
local function IconBar(parent, w, h, rot, pos, color, z)
    local f = MakeFrame({AnchorPoint=Vector2.new(0.5,0.5), Size=UDim2.fromOffset(w,h),
        Position=pos or UDim2.fromScale(0.5,0.5), Rotation=rot or 0,
        BackgroundColor3=color, ZIndex=z or 1, Parent=parent})
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(1,0); c.Parent = f
    return f
end
local function IconHolder(parent, z, size)
    return MakeFrame({Name="Icon", BackgroundTransparency=1, AnchorPoint=Vector2.new(0.5,0.5),
        Position=UDim2.fromScale(0.5,0.5), Size=size or UDim2.fromScale(1,1),
        ZIndex=z or 1, Parent=parent})
end
local Icons = {}
function Icons.X(parent, len, thick, color, z)
    local h = IconHolder(parent, z)
    IconBar(h, len, thick, 45, nil, color, z); IconBar(h, len, thick, -45, nil, color, z)
    return h
end
function Icons.Minus(parent, len, thick, color, z)
    local h = IconHolder(parent, z)
    IconBar(h, len, thick, 0, nil, color, z)
    return h
end
-- Rotation 0 = pointing down; -90 = right; 180 = up
function Icons.Chevron(parent, color, z, scale)
    scale = scale or 1
    local h = IconHolder(parent, z, UDim2.fromOffset(14*scale, 14*scale))
    IconBar(h, 7*scale, 2, 45, UDim2.new(0.5,-2.3*scale,0.5,0), color, z)
    IconBar(h, 7*scale, 2, -45, UDim2.new(0.5,2.3*scale,0.5,0), color, z)
    return h
end
function Icons.Check(parent, color, z)
    local h = IconHolder(parent, z, UDim2.fromOffset(14, 14))
    IconBar(h, 5, 2, 45, UDim2.new(0.5,-2.5,0.5,1), color, z)
    IconBar(h, 9, 2, -45, UDim2.new(0.5,1.4,0.5,-0.4), color, z)
    return h
end
local function PaintIcon(icon, color)
    if not icon then return end
    for _, b in ipairs(icon:GetChildren()) do
        if b:IsA("Frame") then b.BackgroundColor3 = color end
    end
end
NexusLib.Icons = Icons

-- ── Micro-animation helpers ────────────────────────────────
local function GetScale(obj)
    local us = obj:FindFirstChild("NexusScale")
    if not us then us = Instance.new("UIScale"); us.Name = "NexusScale"; us.Parent = obj end
    return us
end
local function AddHoverScale(obj)
    local us = GetScale(obj)
    obj.MouseEnter:Connect(function() Tween(us, {Scale=1.02}, 0.12) end)
    obj.MouseLeave:Connect(function() Tween(us, {Scale=1}, 0.12) end)
end
local function AddPressScale(obj)
    local us = GetScale(obj)
    obj.MouseButton1Down:Connect(function() Tween(us, {Scale=0.96}, 0.07) end)
    obj.MouseButton1Up:Connect(function() TweenSpring(us, {Scale=1}, 0.2) end)
    obj.MouseLeave:Connect(function() TweenSpring(us, {Scale=1}, 0.2) end)
end
local function AddGlow(obj, getTheme)
    local glow = Instance.new("UIStroke")
    glow.Thickness = 0; glow.Transparency = 1
    glow.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    glow.Color = getTheme().Accent; glow.Name = "NexusGlow"; glow.Parent = obj
    obj.MouseEnter:Connect(function()
        Tween(glow, {Transparency=0.35, Thickness=1.5, Color=getTheme().AccentHover}, 0.15)
    end)
    obj.MouseLeave:Connect(function()
        Tween(glow, {Transparency=1, Thickness=0, Color=getTheme().Accent}, 0.15)
    end)
    return glow
end

-- Collapsible: eases a clip frame's height every frame towards a live
-- target, then follows content changes instantly while expanded.
local function Collapsible(clip, contentHeight, onStep, startExpanded)
    local C = {expanded = startExpanded and true or false, animating = false, token = 0}
    local function apply(h)
        clip.Size = UDim2.new(1, 0, 0, h)
        if onStep then onStep(h) end
    end
    function C:Animate(expand, dur)
        self.expanded = expand
        self.token = self.token + 1
        local my = self.token
        self.animating = true
        local startH = clip.Size.Y.Offset
        local t0 = os.clock()
        dur = dur or 0.28
        while true do
            local a = math.clamp((os.clock() - t0) / dur, 0, 1)
            local e = 1 - (1 - a) ^ 4
            local target = expand and contentHeight() or 0
            apply(startH + (target - startH) * e)
            if a >= 1 then break end
            RunService.RenderStepped:Wait()
            if self.token ~= my or not clip.Parent then return end
        end
        self.animating = false
    end
    function C:Follow()
        if self.expanded and not self.animating then apply(contentHeight()) end
    end
    function C:Snap()
        self.token = self.token + 1; self.animating = false
        apply(self.expanded and contentHeight() or 0)
    end
    return C
end

