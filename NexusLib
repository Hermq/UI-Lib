-- A previous instance is fully destroyed (connections included).
if getgenv and getgenv()._NexusLibInstance then
    local old = getgenv()._NexusLibInstance
    pcall(function() old:Destroy() end)
    pcall(function() if old._gui then old._gui:Destroy() end end)
end

local gui = Instance.new("ScreenGui")
gui.Name = "NexusLib"; gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.IgnoreGuiInset = true; gui.DisplayOrder = 999

do
    local parented = false
    if gethui then
        parented = pcall(function() gui.Parent = gethui() end)
    end
    if not parented then
        parented = pcall(function()
            if syn and syn.protect_gui then syn.protect_gui(gui) end
            gui.Parent = game:GetService("CoreGui")
        end)
    end
    if not parented then
        pcall(function() gui.Parent = LocalPlayer:WaitForChild("PlayerGui") end)
    end
end

NexusLib._gui = gui
if getgenv then getgenv()._NexusLibInstance = NexusLib end

-- ── Library Methods ───────────────────────────────────────
function NexusLib:OnUnload(fn)
    if type(fn) == "function" then table.insert(self._unload, fn) end
end

function NexusLib:Destroy()
    if self._destroyed then return end
    self._destroyed = true
    for _, fn in ipairs(self._unload) do
        local ok, err = pcall(fn)
        if not ok then warn("[NexusLib] OnUnload error: " .. tostring(err)) end
    end
    self._unload = {}
    for _, c in pairs(self.Connections) do
        pcall(function() c:Disconnect() end)
    end
    self.Connections = {}; self.Flags = {}; self.Options = {}; self._listening = false
    if self._gui and self._gui.Parent then pcall(function() self._gui:Destroy() end) end
    if getgenv and getgenv()._NexusLibInstance == self then getgenv()._NexusLibInstance = nil end
end

function NexusLib:SetTheme(t)
    self._theme = type(t) == "string" and (self.Themes[t] or self.Themes.Dark) or t
end
NexusLib:SetTheme("Dark")

local function T() return NexusLib._theme end

-- ── Popup manager (one floating panel open at a time) ─────
local activePopup = nil
function NexusLib:ClosePopups()
    if activePopup then
        local p = activePopup; activePopup = nil
        pcall(p.close)
    end
end
local function RegisterPopup(p)
    if activePopup and activePopup ~= p then pcall(activePopup.close) end
    activePopup = p
end
local function UnregisterPopup(p)
    if activePopup == p then activePopup = nil end
end

-- ── Notify ────────────────────────────────────────────────
local notifStack = {}
local NOTIF_W, NOTIF_H, NOTIF_GAP, NOTIF_MARGIN = 290, 64, 8, 16
local function notifPos(i, off)
    local y = -NOTIF_MARGIN - NOTIF_H - (i - 1) * (NOTIF_H + NOTIF_GAP)
    if off then return UDim2.new(1, 24, 1, y) end
    return UDim2.new(1, -(NOTIF_W + NOTIF_MARGIN), 1, y)
end
local function reflowNotifs()
    for i, n in ipairs(notifStack) do Tween(n.shell, {Position = notifPos(i)}, 0.35) end
end

function NexusLib:Notify(opts)
    opts = opts or {}
    if self._destroyed or not gui.Parent then return nil end
    local th = T()
    local nType = opts.Type or "Info"
    local accent = th.Accent
    if nType == "Success" then accent = th.Success
    elseif nType == "Danger" then accent = th.Danger
    elseif nType == "Warning" then accent = th.Warning end
    local duration = opts.Duration or 4
    if #notifStack >= 5 then pcall(notifStack[1].Dismiss) end

    local shell = MakeFrame({Name="NexusNotif", Size=UDim2.fromOffset(NOTIF_W, NOTIF_H),
        BackgroundColor3=th.SecondaryBg, BackgroundTransparency=1, ZIndex=300})
    MakeCorner(shell, 10)
    local stroke = MakeStroke(shell, Color3.new(1,1,1), 1.5); stroke.Transparency = 1
    local sg = Instance.new("UIGradient")
    sg.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, accent),
        ColorSequenceKeypoint.new(0.5, th.Border), ColorSequenceKeypoint.new(1, th.Border)})
    sg.Parent = stroke

    local canvas = Instance.new("CanvasGroup")
    canvas.Size = UDim2.fromScale(1, 1); canvas.BackgroundTransparency = 1
    canvas.GroupTransparency = 1; canvas.ZIndex = 301; canvas.Parent = shell
    MakeCorner(canvas, 10)
    MakeFrame({Size=UDim2.new(0,4,1,0), BackgroundColor3=accent, ZIndex=302, Parent=canvas})
    local wash = MakeFrame({Size=UDim2.new(0,90,1,0), BackgroundColor3=accent, ZIndex=302, Parent=canvas})
    local wg = Instance.new("UIGradient")
    wg.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,0.86), NumberSequenceKeypoint.new(1,1)})
    wg.Parent = wash

    local badge = MakeFrame({Size=UDim2.fromOffset(24,24), Position=UDim2.fromOffset(14,11),
        BackgroundColor3=accent, BackgroundTransparency=0.78, ZIndex=303, Parent=canvas})
    local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(1,0); bc.Parent = badge
    if nType == "Success" then Icons.Check(badge, accent, 304)
    elseif nType == "Danger" then Icons.X(badge, 10, 2, accent, 304)
    else
        MakeLabel({Size=UDim2.fromScale(1,1), Text=(nType=="Warning") and "!" or "i",
            Font=Enum.Font.GothamBold, TextSize=14, TextColor3=accent, ZIndex=304, Parent=badge})
    end
    MakeLabel({Size=UDim2.new(1,-58,0,18), Position=UDim2.fromOffset(46,9),
        Text=opts.Title or "Notice", Font=Enum.Font.GothamBold, TextSize=13,
        TextColor3=th.TextPrimary, TextXAlignment=Enum.TextXAlignment.Left,
        TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=303, Parent=canvas})
    MakeLabel({Size=UDim2.new(1,-58,0,28), Position=UDim2.fromOffset(46,28),
        Text=opts.Text or "", TextSize=12, TextColor3=th.TextSecondary,
        TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Top,
        TextWrapped=true, ZIndex=303, Parent=canvas})
    local track = MakeFrame({Size=UDim2.new(1,0,0,3), Position=UDim2.new(0,0,1,-3),
        BackgroundColor3=accent, BackgroundTransparency=0.85, ZIndex=303, Parent=canvas})
    local bar = MakeFrame({Size=UDim2.fromScale(1,1), BackgroundColor3=accent, ZIndex=304, Parent=track})
    local hit = MakeButton({Size=UDim2.fromScale(1,1), BackgroundTransparency=1, ZIndex=310, Parent=shell})

    shell.Position = notifPos(#notifStack + 1, true)
    shell.Parent = gui
    local N = {shell = shell}
    table.insert(notifStack, N)
    Tween(shell, {Position = notifPos(#notifStack), BackgroundTransparency = 0}, 0.45)
    Tween(stroke, {Transparency = 0}, 0.35)
    Tween(canvas, {GroupTransparency = 0}, 0.35)
    Tween(bar, {Size = UDim2.fromScale(0, 1)}, duration, Enum.EasingStyle.Linear)

    local gone = false
    function N.Dismiss()
        if gone then return end
        gone = true
        local idx = table.find(notifStack, N)
        if idx then table.remove(notifStack, idx) end
        reflowNotifs()
        local p = shell.Position
        Tween(shell, {Position = UDim2.new(1, 24, p.Y.Scale, p.Y.Offset), BackgroundTransparency = 1},
            0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        Tween(stroke, {Transparency = 1}, 0.25)
        Tween(canvas, {GroupTransparency = 1}, 0.25)
        task.delay(0.32, function()
            pcall(function() shell:Destroy() end)
            if opts.Callback then pcall(opts.Callback) end
        end)
    end
    hit.MouseButton1Click:Connect(N.Dismiss)
    task.delay(duration, N.Dismiss)
    return N
end

-- ── Prompt ────────────────────────────────────────────────
-- Buttons: {OK=fn, Cancel=fn} (sorted by name) or ordered
-- {{"Yes", fn}, {"No", fn}}.
function NexusLib:Prompt(opts)
    opts = opts or {}
    local th = T()
    local list = {}
    local buttons = opts.Buttons or {OK = function() end}
    if buttons[1] then
        for _, b in ipairs(buttons) do table.insert(list, {b[1] or b.Name, b[2] or b.Callback}) end
    else
        for k, v in pairs(buttons) do table.insert(list, {k, v}) end
        table.sort(list, function(a, b) return tostring(a[1]) < tostring(b[1]) end)
    end

    local overlay = MakeButton({Size=UDim2.fromScale(1,1), BackgroundColor3=Color3.new(0,0,0),
        BackgroundTransparency=1, ZIndex=500, Parent=gui})
    TweenSine(overlay, {BackgroundTransparency=0.5}, 0.2)
    local W, H = 360, 176
    local modal = MakeFrame({Size=UDim2.fromOffset(W,H), AnchorPoint=Vector2.new(0.5,0.5),
        Position=UDim2.fromScale(0.5,0.5), BackgroundColor3=th.SecondaryBg, ZIndex=501, Parent=gui})
    MakeCorner(modal, 10); MakeStroke(modal, th.Border)
    local sc = Instance.new("UIScale"); sc.Scale = 0.9; sc.Parent = modal
    TweenSpring(sc, {Scale=1}, 0.35)
    MakeLabel({Size=UDim2.new(1,-28,0,24), Position=UDim2.fromOffset(14,10), Text=opts.Title or "Prompt",
        Font=Enum.Font.GothamBold, TextSize=15, TextColor3=th.TextPrimary,
        TextXAlignment=Enum.TextXAlignment.Left, ZIndex=502, Parent=modal})
    MakeLabel({Size=UDim2.new(1,-28,0,80), Position=UDim2.fromOffset(14,38), Text=opts.Text or "",
        TextSize=13, TextColor3=th.TextSecondary, TextWrapped=true,
        TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Top,
        ZIndex=502, Parent=modal})

    local closed = false
    local function close()
        if closed then return end; closed = true
        TweenSine(overlay, {BackgroundTransparency=1}, 0.2)
        Tween(sc, {Scale=0.9}, 0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        Tween(modal, {BackgroundTransparency=1}, 0.18)
        task.delay(0.22, function() pcall(function() overlay:Destroy(); modal:Destroy() end) end)
    end
    local n = math.max(#list, 1)
    local btnW = math.min(110, (W - 28) / n - 8)
    local bx = 14
    for _, entry in ipairs(list) do
        local cb = entry[2]
        local b = MakeButton({Size=UDim2.fromOffset(btnW,32), Position=UDim2.fromOffset(bx, H-48),
            BackgroundColor3=th.ElementBg, Text=tostring(entry[1]), Font=Enum.Font.GothamBold,
            TextSize=12, TextColor3=th.TextPrimary, ZIndex=503, Parent=modal})
        MakeCorner(b, 6); AddHoverScale(b); AddPressScale(b)
        b.MouseEnter:Connect(function() Tween(b, {BackgroundColor3=th.Accent}, 0.1) end)
        b.MouseLeave:Connect(function() Tween(b, {BackgroundColor3=th.ElementBg}, 0.1) end)
        b.MouseButton1Click:Connect(function() close(); if cb then pcall(cb) end end)
        bx = bx + btnW + 8
    end
    return modal
end

-- ═══════════════════════════════════════════════════════════
--  ELEMENT BUILDER  (shared by sections and accordions)
--  ctx = { theme = fn -> theme, R = fn(obj,prop,key), RF = fn(refreshFn),
--          inset = px, order = fn -> next LayoutOrder, depth = n }
-- ═══════════════════════════════════════════════════════════
local AttachElements

local function Counter()
    local n = 0
    return function() n = n + 1; return n end
end

local BLOCKED_KEYS = {
    [Enum.KeyCode.Unknown]=true,[Enum.KeyCode.W]=true,
    [Enum.KeyCode.A]=true,[Enum.KeyCode.S]=true,[Enum.KeyCode.D]=true,
    [Enum.KeyCode.Space]=true,[Enum.KeyCode.Return]=true,
    [Enum.KeyCode.LeftShift]=true,[Enum.KeyCode.LeftControl]=true,
    [Enum.KeyCode.LeftAlt]=true,[Enum.KeyCode.RightAlt]=true,
}
local activeKeybind = nil

local function onScreen(obj)
    if not obj or not obj.Parent or not obj:IsDescendantOf(gui) then return false end
    local p = obj.Parent
    while p and p ~= gui do
        if p:IsA("GuiObject") and not p.Visible then return false end
        p = p.Parent
    end
    local sf = obj:FindFirstAncestorWhichIsA("ScrollingFrame")
    if sf then
        local top, bottom = sf.AbsolutePosition.Y, sf.AbsolutePosition.Y + sf.AbsoluteSize.Y
        local oy, oh = obj.AbsolutePosition.Y, obj.AbsoluteSize.Y
        if oy + oh < top or oy > bottom then return false end
    end
    return true
end

AttachElements = function(obj, container, ctx)
    local th = ctx.theme
    local R, RF = ctx.R, ctx.RF
    local inset = ctx.inset or 8
    local Z = 14 + (ctx.depth or 0) * 2

    local function newRow(h)
        local row = MakeFrame({Size=UDim2.new(1,0,0,h), BackgroundTransparency=1, ZIndex=Z})
        row.LayoutOrder = ctx.order()
        return row
    end
    local function newBg(row, h, isButton)
        local props = {Size=UDim2.new(1,-2*inset,0,h), Position=UDim2.new(0,inset,0,2), ZIndex=Z, Parent=row}
        local bg = isButton and MakeButton(props) or MakeFrame(props)
        R(bg, "BackgroundColor3", "ElementBg"); MakeCorner(bg, 6)
        return bg
    end
    ctx.elements = ctx.elements or {}
    local function finish(row, E, conns)
        row.Parent = container
        E._row = row
        local cleaned = false
        -- _cleanup releases listeners/popups; the owning section/accordion
        -- calls it when it is destroyed so nothing is left connected.
        function E._cleanup()
            if cleaned then return end
            cleaned = true
            for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
            if E._onDestroy then pcall(E._onDestroy) end
        end
        function E:SetVisible(v) row.Visible = v and true or false end
        function E:Destroy()
            E._cleanup()
            local i = table.find(ctx.elements, E)
            if i then table.remove(ctx.elements, i) end
            pcall(function() row:Destroy() end)
        end
        table.insert(ctx.elements, E)
        return E
    end
    local function EC(list, c) table.insert(list, c); AddConn(c); return c end
    local function hoverBg(bg)
        bg.MouseEnter:Connect(function() Tween(bg, {BackgroundColor3=th().ElementHover}, 0.1) end)
        bg.MouseLeave:Connect(function() Tween(bg, {BackgroundColor3=th().ElementBg}, 0.1) end)
    end

    -- ── BUTTON ──────────────────────────────────────────
    function obj:AddButton(o)
        o = o or {}
        local n = o.Name or "Button"; local d = o.Description; local cb = o.Callback or function() end
        local rh = d and 54 or 36
        local row = newRow(rh)
        local btn = newBg(row, rh-4, true)
        AddHoverScale(btn); AddPressScale(btn); AddGlow(btn, th)
        local nl = MakeLabel({Size=UDim2.new(1,-20,0,20), Position=UDim2.new(0,10,0,d and 7 or 6),
            Text=n, TextSize=13, TextXAlignment=Enum.TextXAlignment.Left,
            TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=Z+1, Parent=btn})
        R(nl, "TextColor3", "TextPrimary")
        local dl
        if d then
            dl = MakeLabel({Size=UDim2.new(1,-20,0,16), Position=UDim2.new(0,10,0,27),
                Text=d, TextSize=11, TextXAlignment=Enum.TextXAlignment.Left, ZIndex=Z+1, Parent=btn})
            R(dl, "TextColor3", "TextDim")
        end
        hoverBg(btn)
        btn.MouseButton1Click:Connect(function()
            Tween(btn, {BackgroundColor3=th().Accent}, 0.06)
            task.delay(0.1, function() Tween(btn, {BackgroundColor3=th().ElementBg}, 0.18) end)
            cb()
        end)
        local B = {_button = btn, _label = nl}
        function B:SetCallback(f) cb = f end
        function B:Set(t) nl.Text = tostring(t) end
        B.SetText = B.Set
        function B:SetDescription(t) if dl then dl.Text = tostring(t) end end
        function B:Fire() cb() end
        return finish(row, B, {})
    end

    -- ── TOGGLE ──────────────────────────────────────────
    function obj:AddToggle(o)
        o = o or {}
        local n = o.Name or "Toggle"; local d = o.Description; local st = o.Default or false
        local flag = o.Flag; local cb = o.Callback or function() end
        local rh = d and 54 or 36
        if flag then NexusLib.Flags[flag] = st end
        local row = newRow(rh)
        local bg = newBg(row, rh-4, true)
        AddHoverScale(bg); AddPressScale(bg); AddGlow(bg, th)
        local nl = MakeLabel({Size=UDim2.new(1,-66,0,20), Position=UDim2.new(0,10,0,d and 7 or 6),
            Text=n, TextSize=13, TextXAlignment=Enum.TextXAlignment.Left,
            TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=Z+1, Parent=bg})
        R(nl, "TextColor3", "TextPrimary")
        if d then
            local dl = MakeLabel({Size=UDim2.new(1,-66,0,16), Position=UDim2.new(0,10,0,27),
                Text=d, TextSize=11, TextXAlignment=Enum.TextXAlignment.Left,
                TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=Z+1, Parent=bg})
            R(dl, "TextColor3", "TextDim")
        end
        local pill = MakeFrame({Size=UDim2.new(0,36,0,20), Position=UDim2.new(1,-46,0.5,-10), ZIndex=Z+1, Parent=bg})
        MakeCorner(pill, 10)
        local dot = MakeFrame({Size=UDim2.new(0,14,0,14),
            Position=st and UDim2.new(0,19,0.5,-7) or UDim2.new(0,3,0.5,-7),
            BackgroundColor3=Color3.new(1,1,1), ZIndex=Z+2, Parent=pill})
        MakeCorner(dot, 7)
        local function paint() pill.BackgroundColor3 = st and th().ToggleOn or th().ToggleOff end
        paint(); RF(paint)
        local Tog = {}
        local function SetSt(s, fire)
            s = s and true or false
            st = s; if flag then NexusLib.Flags[flag] = s end
            Tween(pill, {BackgroundColor3 = s and th().ToggleOn or th().ToggleOff}, 0.2)
            Tween(dot, {Size=UDim2.new(0,18,0,14)}, 0.07)
            task.delay(0.07, function()
                Tween(dot, {Position = s and UDim2.new(0,19,0.5,-7) or UDim2.new(0,3,0.5,-7)}, 0.2, Enum.EasingStyle.Quart)
                TweenSpring(dot, {Size=UDim2.new(0,14,0,14)}, 0.25)
            end)
            if fire then cb(s) end
        end
        hoverBg(bg)
        bg.MouseButton1Click:Connect(function() SetSt(not st, true) end)
        function Tog:Set(s, fire) SetSt(s, fire == true) end
        function Tog:Get() return st end
        function Tog:Toggle(fire) SetSt(not st, fire ~= false) end
        function Tog:SetCallback(f) cb = f end
        if flag then NexusLib.Options[flag] = Tog end
        return finish(row, Tog, {})
    end

    -- ── SLIDER ──────────────────────────────────────────
    function obj:AddSlider(o)
        o = o or {}
        local n = o.Name or "Slider"
        local smin, smax = o.Min or 0, o.Max or 100
        if smax < smin then smin, smax = smax, smin end
        local sfx = o.Suffix or ""
        local prec = o.Precision or 0
        local step = o.Increment
        if step then
            local s = tostring(step); local dot = s:find("%.")
            if dot then prec = math.max(prec, #s - dot) end
        else
            step = prec > 0 and 10 ^ (-prec) or 1
        end
        local flag = o.Flag; local cb = o.Callback or function() end
        local function snap(v)
            v = tonumber(v) or smin
            v = math.clamp(v, smin, smax)
            v = smin + math.floor((v - smin) / step + 0.5) * step
            v = math.clamp(v, smin, smax)
            if prec > 0 then v = tonumber(string.format("%." .. prec .. "f", v)) or v
            else v = math.floor(v + 0.5) end
            return v
        end
        local function fmt(v)
            return (prec > 0 and string.format("%." .. prec .. "f", v) or tostring(v)) .. sfx
        end
        local val = snap(o.Default or smin)
        if flag then NexusLib.Flags[flag] = val end

        local row = newRow(54)
        local bg = newBg(row, 48)
        AddGlow(bg, th)
        local nl = MakeLabel({Size=UDim2.new(1,-100,0,20), Position=UDim2.new(0,10,0,6), Text=n,
            TextSize=13, TextXAlignment=Enum.TextXAlignment.Left,
            TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=Z+1, Parent=bg})
        R(nl, "TextColor3", "TextPrimary")
        local vbox = Instance.new("TextBox")
        vbox.Size = UDim2.new(0,74,0,22); vbox.Position = UDim2.new(1,-82,0,6)
        vbox.Font = Enum.Font.GothamBold; vbox.TextSize = 12; vbox.BorderSizePixel = 0
        vbox.ClearTextOnFocus = false; vbox.ZIndex = Z+1; vbox.Parent = bg
        R(vbox, "BackgroundColor3", "TertiaryBg"); R(vbox, "TextColor3", "Accent"); MakeCorner(vbox, 4)
        local track = MakeFrame({Size=UDim2.new(1,-20,0,6), Position=UDim2.new(0,10,0,35), ZIndex=Z+1, Parent=bg})
        R(track, "BackgroundColor3", "TertiaryBg"); MakeCorner(track, 3)
        local fill = MakeFrame({Size=UDim2.new(0,0,1,0), ZIndex=Z+2, Parent=track})
        R(fill, "BackgroundColor3", "Accent"); MakeCorner(fill, 3)
        local thumb = MakeFrame({Size=UDim2.new(0,14,0,14), AnchorPoint=Vector2.new(0.5,0.5),
            BackgroundColor3=Color3.new(1,1,1), ZIndex=Z+3, Parent=track})
        MakeCorner(thumb, 7)

        local sliding = false
        local function visuals(animate)
            local p = (smax > smin) and (val - smin) / (smax - smin) or 0
            if animate then
                Tween(fill, {Size=UDim2.new(p,0,1,0)}, 0.18)
                Tween(thumb, {Position=UDim2.new(p,0,0.5,0)}, 0.18)
            else
                fill.Size = UDim2.new(p,0,1,0); thumb.Position = UDim2.new(p,0,0.5,0)
            end
            if not vbox:IsFocused() then vbox.Text = fmt(val) end
        end
        local function setValue(v, fire, animate)
            v = snap(v)
            local changed = v ~= val
            val = v
            if flag then NexusLib.Flags[flag] = val end
            visuals(animate)
            if fire and changed then cb(val) end
        end
        visuals(false)
        local function slideFromX(x)
            local ap, as = track.AbsolutePosition, track.AbsoluteSize
            local p = math.clamp((x - ap.X) / math.max(as.X, 1), 0, 1)
            setValue(smin + (smax - smin) * p, true, false)
        end
        local hitArea = MakeButton({Size=UDim2.new(1,-12,0,24), Position=UDim2.new(0,6,0,26),
            BackgroundTransparency=1, ZIndex=Z+4, Parent=bg})
        local conns = {}
        hitArea.InputBegan:Connect(function(i)
            if IsPress(i) then
                sliding = true
                slideFromX(PointerPos(i).X)
                TweenSpring(thumb, {Size=UDim2.new(0,18,0,18)}, 0.15)
            end
        end)
        EC(conns, UserInputService.InputChanged:Connect(function(i)
            if sliding and IsMove(i) then slideFromX(PointerPos(i).X) end
        end))
        EC(conns, UserInputService.InputEnded:Connect(function(i)
            if sliding and IsPress(i) then
                sliding = false
                TweenSine(thumb, {Size=UDim2.new(0,14,0,14)}, 0.15)
            end
        end))
        vbox.Focused:Connect(function()
            vbox.Text = prec > 0 and string.format("%." .. prec .. "f", val) or tostring(val)
        end)
        vbox.FocusLost:Connect(function()
            local num = tonumber((vbox.Text:gsub("[^%d%.%-]", "")))
            if num then setValue(num, true, true) else visuals(false) end
            vbox.Text = fmt(val)
        end)
        local Sli = {}
        function Sli:Set(v) setValue(v, false, true) end
        function Sli:Get() return val end
        function Sli:SetCallback(f) cb = f end
        function Sli:SetRange(a, b) smin, smax = a, b; setValue(val, false, true) end
        if flag then NexusLib.Options[flag] = Sli end
        return finish(row, Sli, conns)
    end

    -- ── KEYBIND ─────────────────────────────────────────
    function obj:AddKeybind(o)
        o = o or {}
        local n = o.Name or "Keybind"; local flag = o.Flag
        local cb = o.Callback or function() end
        local rcb = o.ReleaseCallback
        local cur = o.Default
        if type(cur) == "string" then cur = Enum.KeyCode[cur] end
        if flag then NexusLib.Flags[flag] = cur end
        local listening = false
        local row = newRow(36)
        local bg = newBg(row, 32)
        AddGlow(bg, th)
        local nl = MakeLabel({Size=UDim2.new(1,-120,1,0), Position=UDim2.new(0,10,0,0), Text=n,
            TextSize=13, TextXAlignment=Enum.TextXAlignment.Left,
            TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=Z+1, Parent=bg})
        R(nl, "TextColor3", "TextPrimary")
        local kbtn = MakeButton({Size=UDim2.new(0,94,0,22), Position=UDim2.new(1,-102,0.5,-11),
            Text=cur and cur.Name or "None", Font=Enum.Font.GothamBold, TextSize=12, ZIndex=Z+1, Parent=bg})
        R(kbtn, "BackgroundColor3", "TertiaryBg"); MakeCorner(kbtn, 5)
        kbtn.TextColor3 = th().TextSecondary
        RF(function() if not listening then kbtn.TextColor3 = th().TextSecondary end end)
        AddHoverScale(kbtn); AddPressScale(kbtn)
        local KB = {}
        local function showKey()
            kbtn.Text = cur and cur.Name or "None"
            kbtn.BackgroundTransparency = 0
        end
        local function stop()
            if not listening then return end
            listening = false
            if activeKeybind == KB then activeKeybind = nil end
            NexusLib._listening = activeKeybind ~= nil
            kbtn.TextColor3 = th().TextSecondary
            showKey()
        end
        KB._cancel = stop
        local function pulse()
            if not listening then return end
            Tween(kbtn, {BackgroundTransparency=0.45}, 0.35)
            task.delay(0.36, function()
                if not listening then return end
                Tween(kbtn, {BackgroundTransparency=0}, 0.35)
                task.delay(0.36, pulse)
            end)
        end
        kbtn.MouseButton1Click:Connect(function()
            if listening then stop(); return end
            if activeKeybind and activeKeybind ~= KB then pcall(activeKeybind._cancel) end
            listening = true; activeKeybind = KB; NexusLib._listening = true
            kbtn.Text = "..."; kbtn.TextColor3 = th().Accent
            pulse()
        end)
        local conns = {}
        EC(conns, UserInputService.InputBegan:Connect(function(inp, gp)
            if listening then
                if inp.UserInputType == Enum.UserInputType.Keyboard then
                    local k = inp.KeyCode
                    if k == Enum.KeyCode.Escape or k == Enum.KeyCode.Backspace then
                        cur = nil
                    elseif not BLOCKED_KEYS[k] then
                        cur = k
                    end
                    if flag then NexusLib.Flags[flag] = cur end
                    stop()
                    if cur then
                        kbtn.TextColor3 = th().Accent
                        task.delay(0.4, function() if not listening then kbtn.TextColor3 = th().TextSecondary end end)
                    end
                elseif IsPress(inp) then
                    -- clicking anywhere other than the button cancels
                    task.defer(function()
                        local mp = PointerPos(inp)
                        local ap, as = kbtn.AbsolutePosition, kbtn.AbsoluteSize
                        if not (mp.X >= ap.X and mp.X <= ap.X + as.X and mp.Y >= ap.Y and mp.Y <= ap.Y + as.Y) then stop() end
                    end)
                end
                return
            end
            if NexusLib._listening or gp then return end
            if inp.UserInputType == Enum.UserInputType.Keyboard and cur and inp.KeyCode == cur then cb() end
        end))
        EC(conns, UserInputService.InputEnded:Connect(function(inp)
            if listening or not rcb then return end
            if inp.UserInputType == Enum.UserInputType.Keyboard and cur and inp.KeyCode == cur then rcb() end
        end))
        function KB:Set(k)
            if type(k) == "string" then k = Enum.KeyCode[k] end
            cur = k; if flag then NexusLib.Flags[flag] = k end
            if not listening then showKey() end
        end
        function KB:Get() return cur end
        function KB:SetCallback(f) cb = f end
        function KB:SetReleaseCallback(f) rcb = f end
