    -- ════════════════════════════════════════════════════
    --  SEARCH (3.1)
    -- ════════════════════════════════════════════════════
    local function words(q)
        local out = {}
        for w in string.lower(q or ""):gmatch("%S+") do table.insert(out, w) end
        return out
    end
    local function matches(text, ws)
        for _, w in ipairs(ws) do if not string.find(text, w, 1, true) then return false end end
        return true
    end
    local hiddenBy = setmetatable({}, {__mode = "k"})   -- only what search hid gets shown again
    local function hide(o) if o and o.Visible then o.Visible = false; hiddenBy[o] = true end end
    local function unhide(o) if o and hiddenBy[o] then hiddenBy[o] = nil; o.Visible = true end end
    local function filterElements(list, ws, force)
        local hits = 0
        for _, E in ipairs(list or {}) do
            local row = E._row
            if row and row.Parent then
                if E._ctx then   -- accordion: shown if its name or anything inside matches
                    local accHit = force or (E._sname and #ws > 0 and matches(string.lower(E._sname), ws))
                    local sub = filterElements(E._ctx.elements, ws, accHit)
                    if #ws == 0 or accHit or sub > 0 then
                        unhide(row)
                        if #ws > 0 then hits = hits + sub + (accHit and 1 or 0); if sub > 0 and E.Expand then pcall(E.Expand, E) end end
                    else hide(row) end
                elseif #ws == 0 or force or (E._stext and matches(E._stext, ws)) then
                    unhide(row); if #ws > 0 then hits = hits + 1 end
                else
                    hide(row)
                end
            end
        end
        return hits
    end
    local function filterTab(tb, q)
        local ws = words(q)
        local shownSecs, hits = 0, 0
        for _, s in ipairs(tb._sections or {}) do
            local f = s._frame
            if f and f.Parent and not s._noSearch then
                local secHit = #ws > 0 and matches(string.lower(s:GetName()), ws)
                local h = filterElements(s._ctx.elements, ws, secHit)
                if #ws == 0 or secHit or h > 0 then
                    unhide(f)
                    if #ws > 0 then
                        shownSecs = shownSecs + 1; hits = hits + h
                        if s:IsCollapsed() then pcall(s.Expand, s) end
                    end
                else hide(f) end
            end
        end
        return hits, shownSecs, #ws
    end
    Win._filterTab = filterTab
    local function scrollToRow(tb, row)
        task.defer(function()
            local page = tb._page
            if not (page and row and row.Parent) then return end
            RunService.Heartbeat:Wait()
            local y = row.AbsolutePosition.Y - page.AbsolutePosition.Y + page.CanvasPosition.Y - 40
            Tween(page, {CanvasPosition = Vector2.new(0, math.max(0, y))}, 0.3)
            if row:IsA("Frame") then
                local flash = MakeFrame({Size=UDim2.fromScale(1,1), BackgroundColor3=th().Accent, BackgroundTransparency=0.6,
                    ZIndex=40, Parent=row})
                MakeCorner(flash, 6)
                Tween(flash, {BackgroundTransparency=1}, 1.2)
                task.delay(1.3, function() pcall(function() flash:Destroy() end) end)
            end
        end)
    end
    -- global search: every tab (NoSearch tabs too), named elements + section titles
    function Win:Search(q, limit)
        local ws = words(q)
        local out = {}
        if #ws == 0 then return out end
        for _, tb in ipairs(Win._tabs) do
            for _, s in ipairs(tb._sections or {}) do
                if s._frame and s._frame.Parent and not s._noSearch then
                    if matches(string.lower(s:GetName()), ws) then
                        table.insert(out, {tab = tb, section = s:GetName(), name = nil, row = s._frame, score = 1})
                    end
                    local function walk(list)
                        for _, E in ipairs(list or {}) do
                            if E._row and E._row.Parent then
                                if E._sname and E._stext and matches(E._stext, ws) then
                                    local nameHit = matches(string.lower(tostring(E._sname)), ws)
                                    table.insert(out, {tab = tb, section = s:GetName(), name = tostring(E._sname), row = E._row,
                                        score = nameHit and 0 or 2})
                                end
                                if E._ctx then walk(E._ctx.elements) end
                            end
                        end
                    end
                    walk(s._ctx.elements)
                end
            end
        end
        table.sort(out, function(a, b) return a.score < b.score end)
        if limit and #out > limit then
            local cut = {}; for i = 1, limit do cut[i] = out[i] end
            return cut, #out
        end
        return out, #out
    end
    function Win:OpenResult(r)
        if not r or not r.tab then return end
        r.tab:Select()
        if r.tab._searchBox then r.tab._searchBox.Text = r.name or r.section end
        scrollToRow(r.tab, r.row)
    end

    -- ════════════════════════════════════════════════════
    --  AddTab
    -- ════════════════════════════════════════════════════
    function Win:AddTab(topts)
        topts = topts or {}
        local tName = topts.Name or "Tab"
        local tIcon = topts.Icon
        local tbtn = MakeButton({Name="TBtn_" .. tName, Size=UDim2.new(1,0,0,34),
            BackgroundTransparency=1, LayoutOrder=#Win._tabs + 1, ZIndex=12, Parent=tabScroll})
        MakeCorner(tbtn, 6)
        local lx = 14
        if tIcon then
            local img = Instance.new("ImageLabel")
            img.Size = UDim2.fromOffset(16,16); img.Position = UDim2.new(0,12,0.5,-8)
            img.BackgroundTransparency = 1; img.Image = tIcon; img.ZIndex = 13; img.Parent = tbtn
            lx = 34
        end
        local tabLbl = MakeLabel({Size=UDim2.new(1,-lx-6,1,0), Position=UDim2.new(0,lx,0,0), Text=tName,
            TextSize=13, TextXAlignment=Enum.TextXAlignment.Left, TextTruncate=Enum.TextTruncate.AtEnd,
            ZIndex=13, Parent=tbtn})
        local acBar = MakeFrame({Name="AccentBar", AnchorPoint=Vector2.new(0,0.5), Size=UDim2.new(0,4,0,0),
            Position=UDim2.new(0,0,0.5,0), ZIndex=13, Parent=tbtn})
        MakeCorner(acBar, 3)

        local pageWrap = MakeFrame({Name="PW_" .. tName, Size=UDim2.fromScale(1,1),
            BackgroundTransparency=1, Visible=false, ZIndex=11, Parent=pageHolder})
        local page = Instance.new("ScrollingFrame")
        page.Name = "Pg_" .. tName; page.Size = UDim2.fromScale(1,1)
        page.BackgroundTransparency = 1; page.BorderSizePixel = 0; page.ScrollBarThickness = 3
        page.CanvasSize = UDim2.new(); page.AutomaticCanvasSize = Enum.AutomaticSize.Y
        page.ScrollingDirection = Enum.ScrollingDirection.Y
        page.ZIndex = 11; page.ClipsDescendants = true; page.Parent = pageWrap
        R(page, "ScrollBarImageColor3", "ScrollBar")
        local pgLL = Instance.new("UIListLayout"); pgLL.SortOrder = Enum.SortOrder.LayoutOrder
        pgLL.Padding = UDim.new(0,6); pgLL.Parent = page
        local pgPd = Instance.new("UIPadding")
        pgPd.PaddingTop = UDim.new(0,8); pgPd.PaddingLeft = UDim.new(0,8)
        pgPd.PaddingRight = UDim.new(0,10); pgPd.PaddingBottom = UDim.new(0,8); pgPd.Parent = page
        page:GetPropertyChangedSignal("CanvasPosition"):Connect(function() NexusLib:ClosePopups() end)

        local Tab = {_page=page, _wrap=pageWrap, _btn=tbtn, _acBar=acBar, _lbl=tabLbl, _name=tName, _sections={}}
        local order = Counter()
        function Tab:GetSections() return Tab._sections end
        -- 3.1 per-tab search bar (window Search = true, tab NoSearch = true skips it)
        if searchOn and not topts.NoSearch then
            local bar = MakeFrame({Name="SearchBar", Size=UDim2.new(1,0,0,28), BackgroundTransparency=1,
                LayoutOrder=-1000000000, ZIndex=12, Parent=page})
            local sb = Instance.new("TextBox")
            sb.Size = UDim2.new(1,-86,1,0); sb.BorderSizePixel = 0; sb.Text = ""
            sb.PlaceholderText = "Search " .. tName .. "..."; sb.Font = Enum.Font.Gotham; sb.TextSize = 12
            sb.ClearTextOnFocus = false; sb.TextXAlignment = Enum.TextXAlignment.Left; sb.ZIndex = 13; sb.Parent = bar
            R(sb, "BackgroundColor3", "SecondaryBg"); R(sb, "TextColor3", "TextPrimary"); R(sb, "PlaceholderColor3", "TextDim")
            MakeCorner(sb, 6)
            local sp = Instance.new("UIPadding"); sp.PaddingLeft = UDim.new(0,10); sp.PaddingRight = UDim.new(0,8); sp.Parent = sb
            local sst = MakeStroke(sb, th().Border, 1)
            sb.Focused:Connect(function() sst.Color = th().Accent end)
            sb.FocusLost:Connect(function() sst.Color = th().Border end)
            RF(function() if not sb:IsFocused() then sst.Color = th().Border end end)
            local info = MakeLabel({Size=UDim2.new(0,80,1,0), Position=UDim2.new(1,-80,0,0), TextSize=11, Text="",
                TextXAlignment=Enum.TextXAlignment.Right, ZIndex=13, Parent=bar})
            R(info, "TextColor3", "TextDim")
            sb:GetPropertyChangedSignal("Text"):Connect(function()
                local hits, secs, nw = filterTab(Tab, sb.Text)
                info.Text = nw == 0 and "" or (hits == 0 and secs == 0 and "no matches" or (hits .. " found"))
            end)
            Tab._searchBox = sb
            NexusLib:AddPopupCloser(function() if sb:IsFocused() then sb:ReleaseFocus() end end)
        end
        local function paint(sel, animate)
            local t = th()
            local d = animate and 0.15 or 0
            Tween(tbtn, {BackgroundTransparency = sel and 0 or 1, BackgroundColor3 = t.ElementBg}, d)
            Tween(tabLbl, {TextColor3 = sel and t.TextPrimary or t.TextDim}, d)
            acBar.BackgroundColor3 = t.AccentBar
            Tween(acBar, {Size = UDim2.new(0,4,0, sel and 20 or 0)}, animate and 0.25 or 0)
        end
        Tab._paint = function() paint(Win._selected == Tab, false) end
        paint(false, false)
        function Tab:Select()
            if Win._clearGlobalSearch then pcall(Win._clearGlobalSearch) end
            if Win._selected == Tab then return end
            NexusLib:ClosePopups()
            for _, t in ipairs(Win._tabs) do
                if t ~= Tab then t._wrap.Visible = false; t._setSel(false) end
            end
            Win._selected = Tab
            pageWrap.Visible = true
            page.Position = UDim2.fromOffset(0, 10)
            Tween(page, {Position = UDim2.new()}, 0.28)
            paint(true, true)
        end
        Tab._setSel = function(v) paint(v, true) end
        tbtn.MouseButton1Click:Connect(function() Tab:Select() end)
        tbtn.MouseEnter:Connect(function()
            if Win._selected ~= Tab then Tween(tbtn, {BackgroundTransparency=0.6, BackgroundColor3=th().ElementBg}, 0.1) end
        end)
        tbtn.MouseLeave:Connect(function()
            if Win._selected ~= Tab then Tween(tbtn, {BackgroundTransparency=1}, 0.1) end
        end)
        table.insert(Win._tabs, Tab)
        if #Win._tabs == 1 then Tab:Select() end

        -- ── AddSection ──────────────────────────────────
        function Tab:AddSection(sopts)
            sopts = sopts or {}
            local sName = sopts.Name or "Section"
            local HDR_H = 30
            local CLIP_TOP = HDR_H + 1
            local sec = MakeFrame({Name="S_" .. sName, Size=UDim2.new(1,0,0,HDR_H), ZIndex=12, Parent=page})
            sec.LayoutOrder = tonumber(sopts.Order) or order()
            R(sec, "BackgroundColor3", "SecondaryBg"); MakeCorner(sec, 8)
            local hdrBtn = MakeButton({Size=UDim2.new(1,0,0,HDR_H), BackgroundTransparency=1, ZIndex=13, Parent=sec})
            local secHdr = MakeLabel({Size=UDim2.new(1,-40,0,HDR_H), Position=UDim2.new(0,12,0,0),
                Text=sName, Font=Enum.Font.GothamBold, TextSize=12,
                TextXAlignment=Enum.TextXAlignment.Left, TextTruncate=Enum.TextTruncate.AtEnd,
                ZIndex=14, Parent=hdrBtn})
            R(secHdr, "TextColor3", "Accent")
            local chev = Icons.Chevron(hdrBtn, th().TextDim, 14)
            chev.Position = UDim2.new(1,-18,0.5,0)
            RF(function() PaintIcon(chev, th().TextDim) end)
            local secDiv = MakeFrame({Size=UDim2.new(1,-20,0,1), Position=UDim2.new(0,10,0,HDR_H-1), ZIndex=13, Parent=sec})
            R(secDiv, "BackgroundColor3", "Border")
            local secClip = MakeFrame({Size=UDim2.new(1,0,0,0), Position=UDim2.new(0,0,0,CLIP_TOP),
                BackgroundTransparency=1, ClipsDescendants=true, ZIndex=12, Parent=sec})
            local elems = MakeFrame({Name="Elems", Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
                BackgroundTransparency=1, ZIndex=13, Parent=secClip})
            local eLL = Instance.new("UIListLayout"); eLL.SortOrder = Enum.SortOrder.LayoutOrder; eLL.Parent = elems
            local ePd = Instance.new("UIPadding"); ePd.PaddingTop = UDim.new(0,4); ePd.PaddingBottom = UDim.new(0,6); ePd.Parent = elems

            local col = Collapsible(secClip,
                function() return eLL.AbsoluteContentSize.Y + 10 end,
                function(h)
                    sec.Size = UDim2.new(1,0,0, (h > 0.5) and (CLIP_TOP + h) or HDR_H)
                    secDiv.Visible = h > 0.5
                end,
                not sopts.Collapsed)
            chev.Rotation = col.expanded and 0 or -90
            col:Snap()
            eLL:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() col:Follow() end)
            local function setExpanded(e)
                Tween(chev, {Rotation = e and 0 or -90}, 0.22)
                task.spawn(function() col:Animate(e, 0.3) end)
            end
            hdrBtn.MouseButton1Click:Connect(function() setExpanded(not col.expanded) end)
            hdrBtn.MouseEnter:Connect(function() Tween(chev, {Size=UDim2.fromOffset(16,16)}, 0.1) end)
            hdrBtn.MouseLeave:Connect(function() Tween(chev, {Size=UDim2.fromOffset(14,14)}, 0.1) end)

            local Sec = {_frame=sec, _elems=elems, _header=secHdr, _noSearch=sopts.NoSearch == true}
            local secCtx = {theme=th, R=R, RF=RF, inset=8, order=Counter(), depth=0, elements={},
                win=Win, path=tName .. "/" .. sName, noSave=sopts.NoSave == true}
            Sec._ctx = secCtx
            table.insert(Tab._sections, Sec)
            AttachElements(Sec, elems, secCtx)
            function Sec:SetOrder(n) sec.LayoutOrder = tonumber(n) or sec.LayoutOrder end

            function Sec:SetName(newName)
                secHdr.Text = tostring(newName)
                sec.Name = "S_" .. tostring(newName)
            end
            function Sec:GetName() return secHdr.Text end
            function Sec:Expand() setExpanded(true) end
            function Sec:Collapse() setExpanded(false) end
            function Sec:SetCollapsed(c) setExpanded(not c) end
            function Sec:IsCollapsed() return not col.expanded end
            function Sec:SetVisible(v) sec.Visible = v and true or false end
            function Sec:Destroy(instant)
                for _, el in ipairs(secCtx.elements) do pcall(el._cleanup) end
                local si = table.find(Tab._sections, Sec); if si then table.remove(Tab._sections, si) end
                sec.Name = "S__removing"
                if instant then pcall(function() sec:Destroy() end); return end
                col.token = col.token + 1
                sec.ClipsDescendants = true
                local tw = Tween(sec, {Size=UDim2.new(1,0,0,0), BackgroundTransparency=1}, 0.25,
                    Enum.EasingStyle.Quint, Enum.EasingDirection.In)
                if tw then tw.Completed:Once(function() pcall(function() sec:Destroy() end) end)
                else pcall(function() sec:Destroy() end) end
            end
            -- Click the section title to rename it. cb(newName, oldName) may
            -- return false to reject the change.
            function Sec:EnableRename(cb)
                local overlay = MakeButton({BackgroundTransparency=1, ZIndex=16, Parent=hdrBtn,
                    Position=UDim2.new(0,8,0,4), Size=UDim2.new(0,40,0,HDR_H-8)})
                local function fit()
                    overlay.Size = UDim2.new(0, math.max(secHdr.TextBounds.X + 8, 40), 0, HDR_H - 8)
                end
                fit(); secHdr:GetPropertyChangedSignal("TextBounds"):Connect(fit)
                overlay.MouseEnter:Connect(function() Tween(secHdr, {TextColor3=th().AccentHover}, 0.1) end)
                overlay.MouseLeave:Connect(function() Tween(secHdr, {TextColor3=th().Accent}, 0.1) end)
                overlay.MouseButton1Click:Connect(function()
                    local old = secHdr.Text
                    secHdr.Visible = false; overlay.Visible = false
                    local inp = Instance.new("TextBox")
                    inp.Size = UDim2.new(0,190,0,22); inp.Position = UDim2.new(0,8,0.5,-11)
                    inp.BorderSizePixel = 0; inp.Font = Enum.Font.GothamBold; inp.TextSize = 12
                    inp.Text = old; inp.ClearTextOnFocus = false; inp.ZIndex = 17
                    inp.TextXAlignment = Enum.TextXAlignment.Left
                    inp.BackgroundColor3 = th().ElementBg; inp.TextColor3 = th().Accent
                    MakeCorner(inp, 5); MakeStroke(inp, th().Accent, 1).Transparency = 0.4
                    local ip = Instance.new("UIPadding"); ip.PaddingLeft = UDim.new(0,6); ip.Parent = inp
                    inp.Parent = hdrBtn
                    inp:CaptureFocus()
                    inp.FocusLost:Connect(function()
                        local new = inp.Text
                        inp:Destroy(); secHdr.Visible = true; overlay.Visible = true
                        if new == "" or new == old then return end
                        local accept = true
                        if cb then
                            local ok, r = pcall(cb, new, old)
                            if ok and r == false then accept = false end
                        end
                        if accept then Sec:SetName(new) end
                    end)
                end)
            end
            return Sec
        end

        function Tab:AddAccordion(o)
            return NexusLib._makeAccordion(page, {theme=th, R=R, RF=RF, inset=0, order=order, depth=0,
                win=Win, path=tName}, (o and o.Name) or "Group", 0)
        end
        return Tab
    end

    return Win
end


-- ═══════════════════════════════════════════════════════════
--  MOD LIST (3.1): small draggable overlay listing what's on
--  opts: Window (uses Win:GetActiveModules) or Provider = fn -> {labels},
--        Title, TextSize, Position = Vector2 (offset), Visible, Interval,
--        OnMoved(Vector2) (save the position yourself), Accent (Color3)
--  Methods: SetVisible, IsVisible, SetTextSize, SetPosition, GetPosition,
--           SetProvider, SetItems (fixed list), Refresh, Destroy
--  Longest entries on top; lines up to the right on the right half.
-- ═══════════════════════════════════════════════════════════
function NexusLib:CreateModList(opts)
    opts = opts or {}
    local ML = {visible = opts.Visible ~= false, size = opts.TextSize or 14, rows = {}}
    local provider = opts.Provider or (opts.Window and function() return opts.Window:GetActiveModules() end)
        or function() return {} end
    local fixed = nil
    local g = Instance.new("ScreenGui")
    g.Name = "NexusModList"; g.ResetOnSpawn = false; g.IgnoreGuiInset = true; g.DisplayOrder = 5
    g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    local okP = pcall(function() g.Parent = gethui and gethui() or game:GetService("CoreGui") end)
    if not okP then pcall(function() g.Parent = LocalPlayer:WaitForChild("PlayerGui") end) end
    local f = MakeFrame({Name="List", BackgroundTransparency=1, AutomaticSize=Enum.AutomaticSize.XY,
        Size=UDim2.fromOffset(0,0), Parent=g})
    local pos = opts.Position or Vector2.new(12, 60)
    f.Position = UDim2.fromOffset(pos.X, pos.Y)
    local lay = Instance.new("UIListLayout"); lay.SortOrder = Enum.SortOrder.LayoutOrder; lay.Padding = UDim.new(0,1); lay.Parent = f
    local function accent() return opts.Accent or T().Accent end
    local h = MakeLabel({Name="Header", LayoutOrder=0, Active=true, AutomaticSize=Enum.AutomaticSize.X,
        BackgroundTransparency=0.15, Font=Enum.Font.GothamBold, Text=opts.Title or "Modules", Parent=f})
    h.BackgroundColor3 = Color3.fromRGB(20,22,28)
    local hp = Instance.new("UIPadding"); hp.PaddingLeft = UDim.new(0,8); hp.PaddingRight = UDim.new(0,8); hp.Parent = h
    local conns = {}
    local drag = nil
    local function clampPos(x, y)
        local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920,1080)
        local sz = f.AbsoluteSize
        return math.clamp(x, 0, math.max(0, vp.X - sz.X)), math.clamp(y, 0, math.max(0, vp.Y - sz.Y))
    end
    h.InputBegan:Connect(function(i)
        if IsPress(i) then drag = {start = PointerPos(i), pos = Vector2.new(f.Position.X.Offset, f.Position.Y.Offset)} end
    end)
    table.insert(conns, AddConn(UserInputService.InputChanged:Connect(function(i)
        if drag and IsMove(i) then
            local d = PointerPos(i) - drag.start
            local x, y = clampPos(drag.pos.X + d.X, drag.pos.Y + d.Y)
            f.Position = UDim2.fromOffset(x, y)
        end
    end)))
    table.insert(conns, AddConn(UserInputService.InputEnded:Connect(function(i)
        if drag and IsPress(i) then
            drag = nil
            if opts.OnMoved then pcall(opts.OnMoved, Vector2.new(f.Position.X.Offset, f.Position.Y.Offset)) end
        end
    end)))
    local function row(i)
        local r = ML.rows[i]
        if r then return r end
        r = MakeLabel({Name="Row"..i, LayoutOrder=i, AutomaticSize=Enum.AutomaticSize.X, BackgroundTransparency=0.35,
            Font=Enum.Font.GothamMedium, TextColor3=Color3.fromRGB(235,238,245), Parent=f})
        r.BackgroundColor3 = Color3.fromRGB(14,15,20)
        local pad = Instance.new("UIPadding"); pad.PaddingLeft = UDim.new(0,8); pad.PaddingRight = UDim.new(0,8); pad.Parent = r
        MakeFrame({Name="Bar", Size=UDim2.new(0,2,1,0), Parent=r})
        ML.rows[i] = r
        return r
    end
    function ML:Refresh()
        if NexusLib._destroyed then return end
        g.Enabled = ML.visible
        if not ML.visible then return end
        local ok, list = pcall(function() return fixed or provider() end)
        list = (ok and type(list) == "table") and table.clone(list) or {}
        table.sort(list, function(a, b) a, b = tostring(a), tostring(b); if #a ~= #b then return #a > #b end; return a < b end)
        local vpX = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize.X or 1920
        local right = (f.AbsolutePosition.X + f.AbsoluteSize.X / 2) > vpX / 2
        lay.HorizontalAlignment = right and Enum.HorizontalAlignment.Right or Enum.HorizontalAlignment.Left
        local ts = ML.size
        h.TextSize = ts; h.Size = UDim2.fromOffset(0, ts + 8); h.TextColor3 = accent()
        h.Text = ("%s  [%d]"):format(opts.Title or "Modules", #list)
        h.TextXAlignment = right and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left
        for i, name in ipairs(list) do
            local l = row(i)
            l.Visible = true; l.Text = tostring(name); l.TextSize = ts; l.Size = UDim2.fromOffset(0, ts + 6)
            l.TextXAlignment = right and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left
            local bar = l:FindFirstChild("Bar")
            if bar then
                bar.BackgroundColor3 = accent()
                bar.AnchorPoint = right and Vector2.new(1,0) or Vector2.new(0,0)
                bar.Position = right and UDim2.new(1,8,0,0) or UDim2.new(0,-8,0,0)
            end
        end
        for i = #list + 1, #ML.rows do ML.rows[i].Visible = false end
    end
    function ML:SetVisible(v) ML.visible = v and true or false; ML:Refresh() end
    function ML:IsVisible() return ML.visible end
    function ML:SetTextSize(s) ML.size = tonumber(s) or ML.size; ML:Refresh() end
    function ML:SetPosition(v) if typeof(v) == "Vector2" then f.Position = UDim2.fromOffset(clampPos(v.X, v.Y)) end end
    function ML:GetPosition() return Vector2.new(f.Position.X.Offset, f.Position.Y.Offset) end
    function ML:SetProvider(fn) if type(fn) == "function" then provider = fn; fixed = nil; ML:Refresh() end end
    function ML:SetItems(list) fixed = list; ML:Refresh() end
    local alive = true
    function ML:Destroy()
        alive = false
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        pcall(function() g:Destroy() end)
    end
    NexusLib:OnUnload(function() ML:Destroy() end)
    task.spawn(function()
        while alive and not NexusLib._destroyed do
            pcall(ML.Refresh, ML)
            task.wait(opts.Interval or 0.25)
        end
    end)
    return ML
end

return NexusLib
