        for i = 0, 6 do keys[#keys+1] = ColorSequenceKeypoint.new(i/6, Color3.fromHSV((i/6)%1, 1, 1)) end
        hGrad.Color = ColorSequence.new(keys); hGrad.Parent = hueHolder
        local hCur = MakeFrame({Size=UDim2.new(0,4,1,0), AnchorPoint=Vector2.new(0.5,0),
