    --  CONFIG (3.1): every saveable element registers here as "Tab/Section/Name"
    -- ════════════════════════════════════════════════════
    local REG, REG_ORDER = {}, {}
    function Win._register(path, E)
        local k, i = path, 2
        while REG[k] do k = path .. "#" .. i; i = i + 1 end
        REG[k] = E; table.insert(REG_ORDER, k); E._path = k
        local function unreg()
            if REG[k] ~= E then return end
            REG[k] = nil
            local idx = table.find(REG_ORDER, k); if idx then table.remove(REG_ORDER, idx) end
        end
        if E._unreg then local prev = E._unreg; E._unreg = function() prev(); unreg() end else E._unreg = unreg end
        return unreg
    end
    local function alive(E) return not (E._row and E._row.Parent == nil) end
    local function same(a, b)
        if type(a) ~= "table" or type(b) ~= "table" then return a == b end
        if #a ~= #b then return false end
        for i = 1, #a do if a[i] ~= b[i] then return false end end
        return true
    end
    function Win:GetConfig()
        local out = {}
        for _, k in ipairs(REG_ORDER) do
            local E = REG[k]
            if E and alive(E) then
                local ok, v = pcall(E._cfgGet)
                if ok and v ~= nil then out[k] = (type(v) == "table") and table.clone(v) or v end
            end
        end
        return out
    end
    -- applies saved values in creation order; callbacks only fire for values that change
    function Win:LoadConfig(t)
        if type(t) ~= "table" then return 0 end
        local n = 0
        for _, k in ipairs(table.clone(REG_ORDER)) do
            local E, v = REG[k], t[k]
            if E and v ~= nil and alive(E) then
                local ok, cur = pcall(E._cfgGet)
                if not ok or not same(cur, v) then
                    local ok2, err = pcall(E._cfgSet, v)
                    if ok2 then n = n + 1 else warn("[NexusLib] LoadConfig " .. k .. ": " .. tostring(err)) end
                end
            end
        end
        return n
    end
    function Win:GetRegistry() return REG, REG_ORDER end
    local HttpService = game:GetService("HttpService")
    function Win:ExportConfig(t, metaInfo)
        local wrap = {nexusConfig = 1, window = winName, meta = metaInfo, data = t or Win:GetConfig()}
        local ok, txt = pcall(function() return HttpService:JSONEncode(wrap) end)
        if not ok then return nil, txt end
        pcall(function() setclipboard(txt) end)
        return txt
    end
    function Win:ImportConfig(text)
        local ok, t = pcall(function() return HttpService:JSONDecode(text) end)
        if not ok or type(t) ~= "table" then return nil, "not valid config text" end
        if t.nexusConfig and type(t.data) == "table" then return t.data, t.meta end
        return t, nil
    end
    local cfgFolder = opts.ConfigFolder or ("NexusLib_" .. tostring(winName):gsub("[^%w_%-]", "_"))
    local function cfgPath(name) return cfgFolder .. "/" .. tostring(name):gsub("[^%w_%- ]", "_") .. ".json" end
    function Win:SaveConfig(name)
        pcall(function() if not isfolder(cfgFolder) then makefolder(cfgFolder) end end)
        local txt = HttpService:JSONEncode(Win:GetConfig())
        return pcall(function() writefile(cfgPath(name), txt) end)
    end
    function Win:LoadConfigFile(name)
        local ok, t = pcall(function() return HttpService:JSONDecode(readfile(cfgPath(name))) end)
        if not ok then return false end
        Win:LoadConfig(t); return true
    end
    function Win:ListConfigs()
        local out = {}
        pcall(function()
            for _, f in ipairs(listfiles(cfgFolder)) do
                local n = tostring(f):match("([^/\\]+)%.json$"); if n then table.insert(out, n) end
            end
        end)
        table.sort(out)
        return out
    end
