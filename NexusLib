-- ── Notify ────────────────────────────────────────────────
local notifStack = {}
local NOTIF_W, NOTIF_H, NOTIF_GAP, NOTIF_MARGIN = 290, 64, 8, 16
local function notifPos(i, off)
    local y = -NOTIF_MARGIN - NOTIF_H - (i - 1) * (NOTIF_H + NOTIF_GAP)
    if off then return UDim2.new(1, 24, 1, y) end
    return UDim2.new(1, -(NOTIF_W + NOTIF_MARGIN), 1, y)
end
local function reflowNotifs()
    for i, n in ipairs(notifStack) do Tween(n.shell, {Position = notifPos(i)}, 0.35) end
end

function NexusLib:Notify(opts)
    opts = opts or {}
    if self._destroyed or not gui.Parent then return nil end
    local th = T()
    local nType = opts.Type or "Info"
    local accent = th.Accent
    if nType == "Success" then accent = th.Success
    elseif nType == "Danger" then accent = th.Danger
    elseif nType == "Warning" then accent = th.Warning end
    local duration = opts.Duration or 4
    if #notifStack >= 5 then pcall(notifStack[1].Dismiss) end

    local shell = MakeFrame({Name="NexusNotif", Size=UDim2.fromOffset(NOTIF_W, NOTIF_H),
        BackgroundColor3=th.SecondaryBg, BackgroundTransparency=1, ZIndex=300})
    MakeCorner(shell, 10)
    local stroke = MakeStroke(shell, Color3.new(1,1,1), 1.5); stroke.Transparency = 1
    local sg = Instance.new("UIGradient")
    sg.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, accent),
        ColorSequenceKeypoint.new(0.5, th.Border), ColorSequenceKeypoint.new(1, th.Border)})
    sg.Parent = stroke

    local canvas = Instance.new("CanvasGroup")
    canvas.Size = UDim2.fromScale(1, 1); canvas.BackgroundTransparency = 1
    canvas.GroupTransparency = 1; canvas.ZIndex = 301; canvas.Parent = shell
    MakeCorner(canvas, 10)
    MakeFrame({Size=UDim2.new(0,4,1,0), BackgroundColor3=accent, ZIndex=302, Parent=canvas})
    local wash = MakeFrame({Size=UDim2.new(0,90,1,0), BackgroundColor3=accent, ZIndex=302, Parent=canvas})
    local wg = Instance.new("UIGradient")
    wg.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,0.86), NumberSequenceKeypoint.new(1,1)})
    wg.Parent = wash

    local badge = MakeFrame({Size=UDim2.fromOffset(24,24), Position=UDim2.fromOffset(14,11),
        BackgroundColor3=accent, BackgroundTransparency=0.78, ZIndex=303, Parent=canvas})
    local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(1,0); bc.Parent = badge
    if nType == "Success" then Icons.Check(badge, accent, 304)
    elseif nType == "Danger" then Icons.X(badge, 10, 2, accent, 304)
    else
        MakeLabel({Size=UDim2.fromScale(1,1), Text=(nType=="Warning") and "!" or "i",
            Font=Enum.Font.GothamBold, TextSize=14, TextColor3=accent, ZIndex=304, Parent=badge})
    end
    MakeLabel({Size=UDim2.new(1,-58,0,18), Position=UDim2.fromOffset(46,9),
        Text=opts.Title or "Notice", Font=Enum.Font.GothamBold, TextSize=13,
        TextColor3=th.TextPrimary, TextXAlignment=Enum.TextXAlignment.Left,
        TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=303, Parent=canvas})
    MakeLabel({Size=UDim2.new(1,-58,0,28), Position=UDim2.fromOffset(46,28),
        Text=opts.Text or "", TextSize=12, TextColor3=th.TextSecondary,
        TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Top,
        TextWrapped=true, ZIndex=303, Parent=canvas})
    local track = MakeFrame({Size=UDim2.new(1,0,0,3), Position=UDim2.new(0,0,1,-3),
        BackgroundColor3=accent, BackgroundTransparency=0.85, ZIndex=303, Parent=canvas})
    local bar = MakeFrame({Size=UDim2.fromScale(1,1), BackgroundColor3=accent, ZIndex=304, Parent=track})
    local hit = MakeButton({Size=UDim2.fromScale(1,1), BackgroundTransparency=1, ZIndex=310, Parent=shell})

    shell.Position = notifPos(#notifStack + 1, true)
    shell.Parent = gui
    local N = {shell = shell}
    table.insert(notifStack, N)
    Tween(shell, {Position = notifPos(#notifStack), BackgroundTransparency = 0}, 0.45)
    Tween(stroke, {Transparency = 0}, 0.35)
    Tween(canvas, {GroupTransparency = 0}, 0.35)
    Tween(bar, {Size = UDim2.fromScale(0, 1)}, duration, Enum.EasingStyle.Linear)

    local gone = false
    function N.Dismiss()
        if gone then return end
        gone = true
        local idx = table.find(notifStack, N)
        if idx then table.remove(notifStack, idx) end
        reflowNotifs()
        local p = shell.Position
        Tween(shell, {Position = UDim2.new(1, 24, p.Y.Scale, p.Y.Offset), BackgroundTransparency = 1},
            0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        Tween(stroke, {Transparency = 1}, 0.25)
        Tween(canvas, {GroupTransparency = 1}, 0.25)
        task.delay(0.32, function()
            pcall(function() shell:Destroy() end)
            if opts.Callback then pcall(opts.Callback) end
        end)
    end
    hit.MouseButton1Click:Connect(N.Dismiss)
    task.delay(duration, N.Dismiss)
    return N
end

-- ── Prompt ────────────────────────────────────────────────
-- Buttons: {OK=fn, Cancel=fn} (sorted by name) or ordered
-- {{"Yes", fn}, {"No", fn}}.
function NexusLib:Prompt(opts)
    opts = opts or {}
    local th = T()
    local list = {}
    local buttons = opts.Buttons or {OK = function() end}
    if buttons[1] then
        for _, b in ipairs(buttons) do table.insert(list, {b[1] or b.Name, b[2] or b.Callback}) end
    else
        for k, v in pairs(buttons) do table.insert(list, {k, v}) end
        table.sort(list, function(a, b) return tostring(a[1]) < tostring(b[1]) end)
    end

    local overlay = MakeButton({Size=UDim2.fromScale(1,1), BackgroundColor3=Color3.new(0,0,0),
        BackgroundTransparency=1, ZIndex=500, Parent=gui})
    TweenSine(overlay, {BackgroundTransparency=0.5}, 0.2)
    local W, H = 360, 176
    local modal = MakeFrame({Size=UDim2.fromOffset(W,H), AnchorPoint=Vector2.new(0.5,0.5),
        Position=UDim2.fromScale(0.5,0.5), BackgroundColor3=th.SecondaryBg, ZIndex=501, Parent=gui})
    MakeCorner(modal, 10); MakeStroke(modal, th.Border)
    local sc = Instance.new("UIScale"); sc.Scale = 0.9; sc.Parent = modal
    TweenSpring(sc, {Scale=1}, 0.35)
    MakeLabel({Size=UDim2.new(1,-28,0,24), Position=UDim2.fromOffset(14,10), Text=opts.Title or "Prompt",
        Font=Enum.Font.GothamBold, TextSize=15, TextColor3=th.TextPrimary,
        TextXAlignment=Enum.TextXAlignment.Left, ZIndex=502, Parent=modal})
    MakeLabel({Size=UDim2.new(1,-28,0,80), Position=UDim2.fromOffset(14,38), Text=opts.Text or "",
        TextSize=13, TextColor3=th.TextSecondary, TextWrapped=true,
        TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Top,
        ZIndex=502, Parent=modal})

    local closed = false
    local function close()
        if closed then return end; closed = true
        TweenSine(overlay, {BackgroundTransparency=1}, 0.2)
        Tween(sc, {Scale=0.9}, 0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        Tween(modal, {BackgroundTransparency=1}, 0.18)
        task.delay(0.22, function() pcall(function() overlay:Destroy(); modal:Destroy() end) end)
    end
    local n = math.max(#list, 1)
    local btnW = math.min(110, (W - 28) / n - 8)
    local bx = 14
    for _, entry in ipairs(list) do
        local cb = entry[2]
        local b = MakeButton({Size=UDim2.fromOffset(btnW,32), Position=UDim2.fromOffset(bx, H-48),
            BackgroundColor3=th.ElementBg, Text=tostring(entry[1]), Font=Enum.Font.GothamBold,
            TextSize=12, TextColor3=th.TextPrimary, ZIndex=503, Parent=modal})
        MakeCorner(b, 6); AddHoverScale(b); AddPressScale(b)
        b.MouseEnter:Connect(function() Tween(b, {BackgroundColor3=th.Accent}, 0.1) end)
        b.MouseLeave:Connect(function() Tween(b, {BackgroundColor3=th.ElementBg}, 0.1) end)
        b.MouseButton1Click:Connect(function() close(); if cb then pcall(cb) end end)
        bx = bx + btnW + 8
    end
    return modal
end

-- ═══════════════════════════════════════════════════════════
--  ELEMENT BUILDER  (shared by sections and accordions)
--  ctx = { theme = fn -> theme, R = fn(obj,prop,key), RF = fn(refreshFn),
--          inset = px, order = fn -> next LayoutOrder, depth = n }
-- ═══════════════════════════════════════════════════════════
local AttachElements

local function Counter()
    local n = 0
    return function() n = n + 1; return n end
end

local BLOCKED_KEYS = {
    [Enum.KeyCode.Unknown]=true,[Enum.KeyCode.W]=true,
    [Enum.KeyCode.A]=true,[Enum.KeyCode.S]=true,[Enum.KeyCode.D]=true,
    [Enum.KeyCode.Space]=true,[Enum.KeyCode.Return]=true,
    [Enum.KeyCode.LeftShift]=true,[Enum.KeyCode.LeftControl]=true,
    [Enum.KeyCode.LeftAlt]=true,[Enum.KeyCode.RightAlt]=true,
}
local activeKeybind = nil

local function onScreen(obj)
    if not obj or not obj.Parent or not obj:IsDescendantOf(gui) then return false end
    local p = obj.Parent
    while p and p ~= gui do
        if p:IsA("GuiObject") and not p.Visible then return false end
        p = p.Parent
    end
    local sf = obj:FindFirstAncestorWhichIsA("ScrollingFrame")
    if sf then
        local top, bottom = sf.AbsolutePosition.Y, sf.AbsolutePosition.Y + sf.AbsoluteSize.Y
        local oy, oh = obj.AbsolutePosition.Y, obj.AbsoluteSize.Y
        if oy + oh < top or oy > bottom then return false end
    end
    return true
end

AttachElements = function(obj, container, ctx)
    local th = ctx.theme
    local R, RF = ctx.R, ctx.RF
    local inset = ctx.inset or 8
    local Z = 14 + (ctx.depth or 0) * 2

    local function newRow(h)
        local row = MakeFrame({Size=UDim2.new(1,0,0,h), BackgroundTransparency=1, ZIndex=Z})
        row.LayoutOrder = ctx.order()
        return row
    end
    local function newBg(row, h, isButton)
        local props = {Size=UDim2.new(1,-2*inset,0,h), Position=UDim2.new(0,inset,0,2), ZIndex=Z, Parent=row}
        local bg = isButton and MakeButton(props) or MakeFrame(props)
        R(bg, "BackgroundColor3", "ElementBg"); MakeCorner(bg, 6)
        return bg
    end
    ctx.elements = ctx.elements or {}
    local function finish(row, E, conns)
        row.Parent = container
        E._row = row
        local cleaned = false
        -- _cleanup releases listeners/popups; the owning section/accordion
        -- calls it when it is destroyed so nothing is left connected.
        function E._cleanup()
            if cleaned then return end
            cleaned = true
            for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
            if E._onDestroy then pcall(E._onDestroy) end
            if E._unreg then pcall(E._unreg) end
        end
        function E:SetVisible(v) row.Visible = v and true or false end
        function E:Destroy()
            E._cleanup()
            local i = table.find(ctx.elements, E)
            if i then table.remove(ctx.elements, i) end
            pcall(function() row:Destroy() end)
        end
        table.insert(ctx.elements, E)
        return E
    end
    local function EC(list, c) table.insert(list, c); AddConn(c); return c end
    local function hoverBg(bg)
        bg.MouseEnter:Connect(function() Tween(bg, {BackgroundColor3=th().ElementHover}, 0.1) end)
        bg.MouseLeave:Connect(function() Tween(bg, {BackgroundColor3=th().ElementBg}, 0.1) end)
    end
    -- search text + config registration (3.1). ctx.win / ctx.path come from the
    -- owning section; ctx.noSave from Section{NoSave = true}.
    local REG_KINDS = {Toggle = true, Slider = true, Keybind = true, Dropdown = true, ColorPicker = true, Textbox = true}
    local function meta(E, kind, name, text, o)
        o = type(o) == "table" and o or {}
        E._kind = kind; E._sname = name
        E._stext = string.lower(tostring(text or name or ""))
        if o.Module then E._module = (o.Module == true) and tostring(name) or tostring(o.Module) end
        local win = ctx.win
        if win and win._register and name and REG_KINDS[kind] and not ctx.noSave and not o.NoSave
            and (kind ~= "Textbox" or o.Save == true) and E._cfgGet then
            win._register((ctx.path or "?") .. "/" .. tostring(name), E)
        end
    end
    -- ── INLINE LIST (shared by inline dropdowns + combo boxes) ──
    -- A search/list panel that opens inside the row (pushing rows below down).
    -- If it would end below the visible part of the page, the page scrolls to
    -- show it and scrolls back on close (unless the user scrolled meanwhile).
    local function pageOf(x) return x:FindFirstAncestorWhichIsA("ScrollingFrame") end
    local function scrollIntoView(card, state)
        local page = pageOf(card)
        if not page then return end
        state.page, state.prevY = page, page.CanvasPosition.Y
        scrollOwner = state
        task.spawn(function()
            RunService.Heartbeat:Wait(); RunService.Heartbeat:Wait()   -- let the layout grow first
            if not state.open or not page.Parent or scrollOwner ~= state then return end
            local bottom = card.AbsolutePosition.Y + card.AbsoluteSize.Y
            local viewBottom = page.AbsolutePosition.Y + page.AbsoluteWindowSize.Y
            local over = bottom - viewBottom + 8
            if over > 0 then
                state.targetY = page.CanvasPosition.Y + over
                Tween(page, {CanvasPosition = Vector2.new(page.CanvasPosition.X, state.targetY)}, 0.3)
            end
        end)
    end
    local function scrollBack(state)
        -- only the list that scrolled the page last scrolls it back (opening another list while one is
        -- open would otherwise make two tweens fight over the page position)
        if scrollOwner == state and state.targetY and state.page and state.page.Parent
            and math.abs(state.page.CanvasPosition.Y - state.targetY) < 6 then
            Tween(state.page, {CanvasPosition = Vector2.new(state.page.CanvasPosition.X, state.prevY)}, 0.3)
        end
        if scrollOwner == state then scrollOwner = nil end
        state.targetY, state.page = nil, nil
    end
    local function makeListPanel(parent, order, withSearch)
        local t = th()
        local panel = MakeFrame({BackgroundTransparency=1, Visible=false, Size=UDim2.new(1,0,0,0),
            AutomaticSize=Enum.AutomaticSize.Y, LayoutOrder=order, ZIndex=Z+1, Parent=parent})
        local pp = Instance.new("UIPadding")
        pp.PaddingLeft = UDim.new(0,8); pp.PaddingRight = UDim.new(0,8); pp.PaddingBottom = UDim.new(0,8); pp.Parent = panel
        local pl = Instance.new("UIListLayout"); pl.SortOrder = Enum.SortOrder.LayoutOrder; pl.Padding = UDim.new(0,4); pl.Parent = panel
        local search
        if withSearch then
            search = Instance.new("TextBox")
            search.Size = UDim2.new(1,0,0,24); search.LayoutOrder = 1; search.BorderSizePixel = 0
            search.Text = ""; search.PlaceholderText = "Search..."; search.Font = Enum.Font.Gotham; search.TextSize = 12
            search.ClearTextOnFocus = false; search.TextXAlignment = Enum.TextXAlignment.Left; search.ZIndex = Z+2
            search.Parent = panel
            R(search, "BackgroundColor3", "TertiaryBg"); R(search, "TextColor3", "TextPrimary"); R(search, "PlaceholderColor3", "TextDim")
            MakeCorner(search, 4)
            local sp = Instance.new("UIPadding"); sp.PaddingLeft = UDim.new(0,8); sp.Parent = search
        end
        local listFrame = MakeFrame({LayoutOrder=2, Size=UDim2.new(1,0,0,0), ZIndex=Z+2, Parent=panel})
        R(listFrame, "BackgroundColor3", "TertiaryBg"); MakeCorner(listFrame, 4)
        local ls = MakeStroke(listFrame, t.Accent, 1); ls.Transparency = 0.5
        RF(function() ls.Color = th().Accent end)
        local scroll = Instance.new("ScrollingFrame")
        scroll.Size = UDim2.new(1,-8,1,-8); scroll.Position = UDim2.new(0,4,0,4)
        scroll.BackgroundTransparency = 1; scroll.BorderSizePixel = 0; scroll.ScrollBarThickness = 4
        scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y; scroll.CanvasSize = UDim2.new(); scroll.ZIndex = Z+3
        scroll.Parent = listFrame
        R(scroll, "ScrollBarImageColor3", "ScrollBar")
        local sl = Instance.new("UIListLayout"); sl.SortOrder = Enum.SortOrder.LayoutOrder; sl.Padding = UDim.new(0,2); sl.Parent = scroll
        return panel, search, listFrame, scroll
    end
    local ROW_H, MAX_ROWS = 24, 7
    -- ── "was this press inside the list?" without pointer coordinates ──
    -- The pointer position and the GUI's AbsolutePosition can be in different spaces (top bar inset:
    -- ~58 px off in some executors/containers), which made 3.1.0-3.1.2 close lists before a row's click
    -- landed or hit the wrong row. Now the engine decides: every part of a list marks the press via its
    -- own GuiObject.InputBegan, and an outside-press close only happens a frame later if nothing inside
    -- was pressed.
    local function markInside(state, obj)
        if not (obj and obj:IsA("GuiObject")) then return end
        obj.InputBegan:Connect(function(inp) if IsPress(inp) then state.touchT = os.clock() end end)
    end
    local function closeUnlessInside(state, closeFn)
        local t0 = os.clock()
        task.spawn(function()
            RunService.Heartbeat:Wait()
            if not state.open then return end
            if state.touchT and state.touchT > t0 - 0.05 then return end   -- the press was inside
            closeFn()
        end)
    end
    -- fills `scroll` with item rows. rowFn(item) -> {text=, on=, click=fn}
    -- A row is picked on press (its own InputBegan = engine hit test), with MouseButton1Click as a fallback.
    local function fillList(state, scroll, listFrame, items, rowFn, emptyText)
        for _, c in ipairs(scroll:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
        local t = th()
        if #items == 0 then
            MakeLabel({Size=UDim2.new(1,-6,0,ROW_H), TextSize=12, TextXAlignment=Enum.TextXAlignment.Left,
                Text="  " .. (emptyText or "Nothing matches"), TextColor3=t.TextDim, ZIndex=Z+4, Parent=scroll})
        end
        for i, item in ipairs(items) do
            local info = rowFn(item)
            local b = MakeButton({LayoutOrder=i, Size=UDim2.new(1,-6,0,ROW_H), ZIndex=Z+4, Parent=scroll})
            MakeCorner(b, 4)
            local l = MakeLabel({Size=UDim2.new(1,-30,1,0), Position=UDim2.new(0,8,0,0), TextSize=12,
                TextXAlignment=Enum.TextXAlignment.Left, TextTruncate=Enum.TextTruncate.AtEnd,
                Text=info.text, ZIndex=Z+5, Parent=b})
            local mark = Icons.Check(b, Color3.new(1,1,1), Z+5)
            mark.AnchorPoint = Vector2.new(0.5,0.5); mark.Position = UDim2.new(1,-12,0.5,0)
            local function paintRow()
                if not b.Parent then return end
                local on = info.on and info.on() or false
                local th2 = th()
                b.BackgroundColor3 = on and th2.Accent or th2.ElementBg
                l.TextColor3 = th2.TextPrimary
                mark.Visible = on
            end
            paintRow()
            local pickedAt = -1
            local function pick()
                if os.clock() - pickedAt < 0.4 then return end   -- press + click of the same tap = one pick
                pickedAt = os.clock()
                state.touchT = os.clock()
                local ok, err = pcall(info.click)
                if not ok then warn("[NexusLib] list pick: " .. tostring(err)) end
                paintRow()
            end
            b.InputBegan:Connect(function(inp) if IsPress(inp) then state.touchT = os.clock(); pick() end end)
            b.MouseButton1Click:Connect(pick)
            b.MouseEnter:Connect(function() if not (info.on and info.on()) then b.BackgroundColor3 = th().ElementHover end end)
            b.MouseLeave:Connect(paintRow)
        end
        listFrame.Size = UDim2.new(1,0,0, math.min(math.max(#items,1), MAX_ROWS) * (ROW_H + 2) + 8)
    end

    -- ── INLINE DROPDOWN (Dropdown{Inline = true} / window InlineDropdowns) ──
    local function addInlineDropdown(o)
        local n = o.Name or "Dropdown"; local itemsSrc = o.Items or {}
        local multi = o.Multi == true
        local flag = o.Flag; local cb = o.Callback or function() end
        local placeholder = o.Placeholder or (multi and "None" or "Select...")
        local selected
        if multi then
            selected = {}
            if type(o.Default) == "table" then for _, v in ipairs(o.Default) do table.insert(selected, v) end end
        else selected = o.Default end
        local function copySel() if not multi then return selected end; return table.clone(selected) end
        if flag then NexusLib.Flags[flag] = copySel() end
        local function getItems()
            local it = itemsSrc
            if type(it) == "function" then local ok, r = pcall(it); it = ok and r or {} end
            return type(it) == "table" and it or {}
        end
        local function isSel(v) if multi then return table.find(selected, v) ~= nil end; return selected == v end
        local function summary()
            if multi then
                if #selected == 0 then return placeholder end
                if #selected <= 2 then local tt = {}; for i, v in ipairs(selected) do tt[i] = tostring(v) end; return table.concat(tt, ", ") end
                return #selected .. " selected"
            end
            return selected ~= nil and tostring(selected) or placeholder
        end
        local row = newRow(36)
        row.AutomaticSize = Enum.AutomaticSize.Y; row.Size = UDim2.new(1,0,0,0)
        local rp = Instance.new("UIPadding"); rp.PaddingBottom = UDim.new(0,4); rp.Parent = row
        local card = MakeFrame({Position=UDim2.new(0,inset,0,2), Size=UDim2.new(1,-2*inset,0,0),
            AutomaticSize=Enum.AutomaticSize.Y, ZIndex=Z, Parent=row})
        R(card, "BackgroundColor3", "ElementBg"); MakeCorner(card, 6)
        local lay = Instance.new("UIListLayout"); lay.SortOrder = Enum.SortOrder.LayoutOrder; lay.Parent = card
        local header = MakeButton({BackgroundTransparency=1, Size=UDim2.new(1,0,0,32), LayoutOrder=1, ZIndex=Z+1, Parent=card})
        local nl = MakeLabel({Size=UDim2.new(0.42,-10,1,0), Position=UDim2.new(0,10,0,0), Text=n, TextSize=13,
            TextXAlignment=Enum.TextXAlignment.Left, TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=Z+2, Parent=header})
        R(nl, "TextColor3", "TextPrimary")
        local box = MakeFrame({Size=UDim2.new(0.58,-8,0,24), Position=UDim2.new(0.42,0,0.5,-12), ZIndex=Z+2, Parent=header})
        R(box, "BackgroundColor3", "TertiaryBg"); MakeCorner(box, 5)
        local bStroke = MakeStroke(box, th().Border, 1)
        local disp = MakeLabel({Size=UDim2.new(1,-30,1,0), Position=UDim2.new(0,8,0,0), TextSize=12,
            TextXAlignment=Enum.TextXAlignment.Left, TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=Z+3, Parent=box})
        local chev = Icons.Chevron(box, th().TextDim, Z+3)
        chev.Position = UDim2.new(1,-13,0.5,0)
        local function paint()
            local empty = (multi and #selected == 0) or (not multi and selected == nil)
            disp.Text = summary()
            disp.TextColor3 = empty and th().TextSecondary or th().Accent
            PaintIcon(chev, th().TextDim)
        end
        paint(); RF(paint)
        local panel, search, listFrame, scroll = makeListPanel(card, 2, o.Search ~= false)
        local D = {}
        local state = {open = false}
        local popup = {}
        local function rebuild()
            local q = search and search.Text:lower() or ""
            local shown = {}
            for _, v in ipairs(getItems()) do
                if q == "" or tostring(v):lower():find(q, 1, true) then table.insert(shown, v) end
            end
            fillList(state, scroll, listFrame, shown, function(v)
                return {text = tostring(v), on = function() return isSel(v) end, click = function()
                    if multi then
                        local k = table.find(selected, v)
                        if k then table.remove(selected, k) else table.insert(selected, v) end
                        if flag then NexusLib.Flags[flag] = copySel() end
                        paint(); pcall(cb, copySel())
                    else
                        selected = v
                        if flag then NexusLib.Flags[flag] = v end
                        paint(); pcall(cb, v); D:Close()
                    end
                end}
            end)
        end
        if search then search:GetPropertyChangedSignal("Text"):Connect(function() if state.open then rebuild() end end) end
        local conns = {}
        function D:Open()
            if state.open then return end
            state.open = true; inlineOpen[popup] = true
            panel.Visible = true; Tween(chev, {Rotation = 180}, 0.2)
            bStroke.Color = th().Accent
            if search then search.Text = "" end
            rebuild()
            scrollIntoView(card, state)
        end
        function D:Close()
            if not state.open then return end
            state.open = false; inlineOpen[popup] = nil
            panel.Visible = false; Tween(chev, {Rotation = 0}, 0.2)
            bStroke.Color = th().Border
            if search then pcall(function() search:ReleaseFocus() end) end
            scrollBack(state)
        end
        popup.close = function() D:Close() end
        header.MouseButton1Click:Connect(function() if state.open then D:Close() else D:Open() end end)
        for _, x in ipairs({card, header, box, panel, listFrame, scroll, search}) do markInside(state, x) end
        EC(conns, UserInputService.InputBegan:Connect(function(inp)
            if state.open and IsPress(inp) then closeUnlessInside(state, function() D:Close() end) end
        end))
        function D:IsOpen() return state.open end
        function D:Get() return copySel() end
        function D:Set(v)
            if multi then
                selected = {}
                if type(v) == "table" then for _, x in ipairs(v) do table.insert(selected, x) end end
            else selected = v end
            if flag then NexusLib.Flags[flag] = copySel() end
            paint(); if state.open then rebuild() end
        end
        function D:Refresh()
            if multi then   -- drop selections that no longer exist
                local items = getItems()
                if #items > 0 then
                    local have = {}; for _, x in ipairs(items) do have[x] = true end
                    local keep = {}; for _, x in ipairs(selected) do if have[x] then table.insert(keep, x) end end
                    selected = keep
                    if flag then NexusLib.Flags[flag] = copySel() end
                end
            end
            paint(); if state.open then rebuild() end
        end
        function D:SetItems(i) itemsSrc = i; D:Refresh() end
        function D:SetCallback(f) cb = f end
        D._cfgGet = function() return copySel() end
        D._cfgSet = function(v) D:Set(v); pcall(cb, copySel()) end
        D._onDestroy = function() D:Close() end
        if flag then NexusLib.Options[flag] = D end
        meta(D, "Dropdown", n, n .. " " .. (o.Description or ""), o)
        return finish(row, D, conns)
    end

    -- ── COMBO BOX (type a name or pick one from the list) ──
    -- o: Name/Title, Placeholder, Items (table or fn), Default, Callback(text, picked),
    --    Highlight(item) -> bool (marked), OnOpen() (before the list opens),
    --    EmptyText(typed) -> string, Status (initial status line text),
    --    Format(item) -> display text (picking still puts the item itself in the box).
    function obj:AddComboBox(o)
        o = o or {}
        local itemsSrc = o.Items or {}
        local cb = o.Callback or function() end
        local function getItems()
            local it = itemsSrc
            if type(it) == "function" then local ok, r = pcall(it); it = ok and r or {} end
            return type(it) == "table" and it or {}
        end
        local row = newRow(36)
        row.AutomaticSize = Enum.AutomaticSize.Y; row.Size = UDim2.new(1,0,0,0)
        local rp = Instance.new("UIPadding"); rp.PaddingBottom = UDim.new(0,4); rp.Parent = row
        local card = MakeFrame({Position=UDim2.new(0,inset,0,2), Size=UDim2.new(1,-2*inset,0,0),
            AutomaticSize=Enum.AutomaticSize.Y, ZIndex=Z, Parent=row})
        R(card, "BackgroundColor3", "ElementBg"); MakeCorner(card, 6)
        local pad = Instance.new("UIPadding")
        pad.PaddingLeft = UDim.new(0,10); pad.PaddingRight = UDim.new(0,10); pad.PaddingTop = UDim.new(0,8); pad.PaddingBottom = UDim.new(0,8)
        pad.Parent = card
        local lay = Instance.new("UIListLayout"); lay.SortOrder = Enum.SortOrder.LayoutOrder; lay.Padding = UDim.new(0,6); lay.Parent = card
        local title = o.Name or o.Title
        if title then
            local tl = MakeLabel({Size=UDim2.new(1,0,0,18), Text=title, Font=Enum.Font.GothamBold, TextSize=13,
                TextXAlignment=Enum.TextXAlignment.Left, LayoutOrder=1, ZIndex=Z+1, Parent=card})
            R(tl, "TextColor3", "TextPrimary")
        end
        local box = Instance.new("TextBox")
        box.Size = UDim2.new(1,0,0,28); box.LayoutOrder = 2; box.BorderSizePixel = 0; box.Text = o.Default or ""
        box.PlaceholderText = o.Placeholder or "Type a name, or click to pick one"
        box.Font = Enum.Font.Gotham; box.TextSize = 12; box.ClearTextOnFocus = false
        box.TextXAlignment = Enum.TextXAlignment.Left; box.ZIndex = Z+1; box.Parent = card
        R(box, "BackgroundColor3", "TertiaryBg"); R(box, "TextColor3", "TextPrimary"); R(box, "PlaceholderColor3", "TextDim")
        MakeCorner(box, 4)
        local bp = Instance.new("UIPadding"); bp.PaddingLeft = UDim.new(0,8); bp.PaddingRight = UDim.new(0,8); bp.Parent = box
        local stroke = MakeStroke(box, th().Border, 1)
        box.Focused:Connect(function() stroke.Color = th().Accent end)
        local listHolder = MakeFrame({BackgroundTransparency=1, Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
            LayoutOrder=3, ZIndex=Z+1, Parent=card})
        local panel, _, listFrame, scroll = makeListPanel(listHolder, 1, false)
        local pp = panel:FindFirstChildOfClass("UIPadding"); if pp then pp.PaddingLeft = UDim.new(0,0); pp.PaddingRight = UDim.new(0,0); pp.PaddingBottom = UDim.new(0,0) end
        local status = MakeLabel({Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, TextWrapped=true,
            TextSize=11, Text=o.Status or "", TextXAlignment=Enum.TextXAlignment.Left, LayoutOrder=4, ZIndex=Z+1, Parent=card})
        R(status, "TextColor3", "TextSecondary")
        status.Visible = (o.Status or "") ~= ""
        local CB = {_box = box}
        local state = {open = false, filtering = false, picking = false}
        local popup = {}
        local function trim(s) return (s or ""):match("^%s*(.-)%s*$") end
        local function rebuild()
            local typed = trim(box.Text)
            local q = state.filtering and typed:lower() or ""
            local shown = {}
            for _, v in ipairs(getItems()) do
                if q == "" or tostring(v):lower():find(q, 1, true) then table.insert(shown, v) end
            end
            local empty = o.EmptyText and o.EmptyText(typed) or (#getItems() == 0 and "Nothing here yet" or "No match")
            fillList(state, scroll, listFrame, shown, function(v)
                local hl = o.Highlight and o.Highlight(v)
                local shownText = o.Format and o.Format(v) or (tostring(v) .. (hl and "   (current)" or ""))
                return {text = tostring(shownText), on = function() return hl and true or false end,
                    click = function()
                        state.picking = true; box.Text = tostring(v); state.picking = false
                        CB:Close(); pcall(cb, tostring(v), true)
                    end}
            end, empty)
        end
        function CB:Open()
            if state.open then return end
            if o.OnOpen then pcall(o.OnOpen) end
            state.open, state.filtering = true, false; inlineOpen[popup] = true
            panel.Visible = true; rebuild()
            scrollIntoView(card, state)
        end
        function CB:Close()
            if not state.open then return end
            state.open = false; inlineOpen[popup] = nil
            panel.Visible = false; stroke.Color = th().Border
            pcall(function() box:ReleaseFocus() end)
            scrollBack(state)
        end
        popup.close = function() CB:Close() end
        box.Focused:Connect(function() CB:Open() end)
        box:GetPropertyChangedSignal("Text"):Connect(function()
            if state.open and not state.picking then state.filtering = true; rebuild() end
        end)
        box.FocusLost:Connect(function(enter)
            -- clicking a row takes focus away first: the list stays open for that press (decided a frame later)
            if enter then CB:Close() else closeUnlessInside(state, function() CB:Close() end) end
            stroke.Color = th().Border
            if enter then pcall(cb, trim(box.Text), false) end
        end)
        local conns = {}
        for _, x in ipairs({card, box, listHolder, panel, listFrame, scroll}) do markInside(state, x) end
        EC(conns, UserInputService.InputBegan:Connect(function(inp)
            if state.open and IsPress(inp) and not box:IsFocused() then
                closeUnlessInside(state, function() CB:Close() end)
            end
        end))
        function CB:Get() return trim(box.Text) end
        function CB:Set(t) box.Text = tostring(t or "") end
        function CB:SetStatus(t, color)
            status.Text = tostring(t or ""); status.Visible = status.Text ~= ""
            status.TextColor3 = color or th().TextSecondary
        end
        function CB:Refresh() if state.open then rebuild() end end
        function CB:SetItems(i) itemsSrc = i; CB:Refresh() end
        function CB:SetCallback(f) cb = f end
        function CB:IsOpen() return state.open end
        CB._onDestroy = function() CB:Close() end
        meta(CB, "ComboBox", title or "Combo box", (title or "") .. " " .. (o.Placeholder or ""), o)
        return finish(row, CB, conns)
    end

