function NexusLib._makeAccordion(parentContainer, parentCtx, name, depth)
    depth = depth or 0
    local th, R, RF = parentCtx.theme, parentCtx.R, parentCtx.RF
    local HDR_H  = math.max(36 - depth * 3, 28)
    local BAR_W  = math.max(4 - depth, 2)
    local FSIZE  = math.max(13 - depth, 11)
    local PAD_V  = math.max(7 - depth * 2, 3)
    local PAD_H  = math.max(6 - depth, 2)
    local hdrKey = depth == 0 and "SecondaryBg" or "TertiaryBg"
    local inset  = parentCtx.inset or 8
    local Z = 12 + depth * 2

    local row = MakeFrame({Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
        BackgroundTransparency=1, ZIndex=Z})
    row.LayoutOrder = parentCtx.order()
    local header = MakeButton({Size=UDim2.new(1,-2*inset,0,HDR_H), Position=UDim2.new(0,inset,0,0), ZIndex=Z+1, Parent=row})
    header.BackgroundColor3 = th()[hdrKey]
    MakeCorner(header, math.max(8 - depth * 2, 4))
    local acBar = MakeFrame({Size=UDim2.new(0,BAR_W,1,-math.floor(HDR_H*0.4)),
        Position=UDim2.new(0,0,0,math.floor(HDR_H*0.2)), ZIndex=Z+2, Parent=header})
    MakeCorner(acBar, 3)
    local nameLbl = MakeLabel({Size=UDim2.new(1,-44,1,0), Position=UDim2.new(0,BAR_W+8,0,0),
        Text=name, Font=depth == 0 and Enum.Font.GothamBold or Enum.Font.Gotham, TextSize=FSIZE,
        TextXAlignment=Enum.TextXAlignment.Left, ZIndex=Z+2, Parent=header})
    local chev = Icons.Chevron(header, th().TextDim, Z+2)
    chev.Position = UDim2.new(1,-16,0.5,0); chev.Rotation = -90
    local clip = MakeFrame({Size=UDim2.new(1,0,0,0), Position=UDim2.new(0,0,0,HDR_H+2),
        BackgroundTransparency=1, ClipsDescendants=true, ZIndex=Z, Parent=row})
    local inner = MakeFrame({Size=UDim2.new(1,-2*inset,0,0), Position=UDim2.new(0,inset,0,0),
        AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, ZIndex=Z, Parent=clip})
    local ll = Instance.new("UIListLayout"); ll.SortOrder = Enum.SortOrder.LayoutOrder
    ll.Padding = UDim.new(0, math.max(5 - depth, 2)); ll.Parent = inner
    local pd = Instance.new("UIPadding")
    pd.PaddingTop = UDim.new(0,PAD_V); pd.PaddingBottom = UDim.new(0,PAD_V)
    pd.PaddingLeft = UDim.new(0,PAD_H); pd.PaddingRight = UDim.new(0,PAD_H); pd.Parent = inner

    local col = Collapsible(clip, function() return ll.AbsoluteContentSize.Y + PAD_V * 2 end, nil, false)
    ll:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() col:Follow() end)
    local function paint()
        local t = th()
        header.BackgroundColor3 = col.expanded and t.ElementHover or t[hdrKey]
        acBar.BackgroundColor3 = col.expanded and t.AccentBar or t.Accent
        nameLbl.TextColor3 = depth == 0 and t.TextPrimary or t.TextSecondary
        PaintIcon(chev, t.TextDim)
    end
    paint(); RF(paint)
    local function setExpanded(e)
        Tween(chev, {Rotation = e and 0 or -90}, 0.2)
        Tween(header, {BackgroundColor3 = e and th().ElementHover or th()[hdrKey]}, 0.12)
        acBar.BackgroundColor3 = e and th().AccentBar or th().Accent
        task.spawn(function() col:Animate(e, 0.28) end)
    end
    header.MouseButton1Click:Connect(function() setExpanded(not col.expanded) end)
    header.MouseEnter:Connect(function()
        if not col.expanded then Tween(header, {BackgroundColor3=th().ElementHover}, 0.1) end
    end)
    header.MouseLeave:Connect(function()
        if not col.expanded then Tween(header, {BackgroundColor3=th()[hdrKey]}, 0.1) end
    end)
    row.Parent = parentContainer

    local Acc = {_row = row, _inner = inner, _sname = name}
    local childCtx = {theme = th, R = R, RF = RF, inset = 0, order = Counter(),
        depth = depth, isAccordion = true, sepBg = depth == 0 and "Background" or "SecondaryBg",
        win = parentCtx.win, path = parentCtx.path, noSave = parentCtx.noSave}
    Acc._ctx = childCtx
    AttachElements(Acc, inner, childCtx)
    function Acc:AddAccordion(o)
        return NexusLib._makeAccordion(inner, childCtx, (o and o.Name) or "Group", depth + 1)
    end
    function Acc:Expand() setExpanded(true) end
    function Acc:Collapse() setExpanded(false) end
    function Acc:SetName(t) nameLbl.Text = tostring(t) end
    function Acc:SetVisible(v) row.Visible = v and true or false end
    function Acc._cleanup()
        for _, el in ipairs(childCtx.elements or {}) do pcall(el._cleanup) end
    end
    function Acc:Destroy()
        Acc._cleanup()
        local i = parentCtx.elements and table.find(parentCtx.elements, Acc)
        if i then table.remove(parentCtx.elements, i) end
        pcall(function() row:Destroy() end)
    end
    parentCtx.elements = parentCtx.elements or {}
    table.insert(parentCtx.elements, Acc)
    Acc._remeasure = function() col:Follow() end
    return Acc
end

