function NexusLib:CreateWindow(opts)
    opts = opts or {}
    local theme = opts.Theme
    if type(theme) == "string" then theme = self.Themes[theme] or self._theme
    elseif type(theme) ~= "table" then theme = self._theme end
    self._theme = theme

    local winName   = opts.Name or "Script"
    local winW      = (opts.Size and opts.Size.X) or 580
    local winH      = (opts.Size and opts.Size.Y) or 400
    local toggleKey = opts.ToggleKey
    local statusTxt = opts.Status or ""
    local bgUrl     = opts.CustomBackground
    local destroyOnClose = opts.DestroyOnClose ~= false
    local searchOn = opts.Search == true
    if opts.KeybindNotifications ~= nil then NexusLib.KeybindNotifications = opts.KeybindNotifications == true end
    local TBAR, SBAR, TABW = 40, 22, 130

    local Win = {_theme = theme, _tabs = {}, _minimized = false, _closeCbs = {}, _conns = {},
        _inlineDropdowns = opts.InlineDropdowns == true}
    local function th() return Win._theme end
    local _refs, _fns = {}, {}
    local function R(obj, prop, key)
        table.insert(_refs, {obj, prop, key})
        pcall(function() obj[prop] = Win._theme[key] end)
    end
    local function RF(fn) table.insert(_fns, fn) end
    Win._refs = _refs
    local function WC(c) table.insert(Win._conns, c); AddConn(c); return c end
    if type(opts.OnClose) == "function" then table.insert(Win._closeCbs, opts.OnClose) end

    local mainFrame = MakeFrame({Name="NexusWindow", Size=UDim2.fromOffset(winW, winH),
        Position=UDim2.new(0.5,-winW/2,0.5,-winH/2), ZIndex=10, ClipsDescendants=true,
        BackgroundTransparency=1, Parent=gui})
    R(mainFrame, "BackgroundColor3", "Background"); MakeCorner(mainFrame, 10)
    local winStroke = MakeStroke(mainFrame, th().Border, 1)
    RF(function() winStroke.Color = th().Border end)
    local winScale = Instance.new("UIScale"); winScale.Name = "WindowScale"; winScale.Scale = 0.94
    winScale.Parent = mainFrame
    Win._frame = mainFrame; Win._scale = winScale

    local bgImage = nil
    local function makeBgImage(url)
        bgImage = Instance.new("ImageLabel")
        bgImage.Size = UDim2.fromScale(1,1); bgImage.BackgroundTransparency = 1
        bgImage.Image = url; bgImage.ImageTransparency = 0.65
        bgImage.ScaleType = Enum.ScaleType.Crop; bgImage.ZIndex = 10; bgImage.Parent = mainFrame
        MakeCorner(bgImage, 10)
    end
    if type(bgUrl) == "string" and bgUrl ~= "" then makeBgImage(bgUrl) end

    TweenSpring(winScale, {Scale=1}, 0.45)
    Tween(mainFrame, {BackgroundTransparency=0}, 0.3)

    -- Title bar
    local tbar = MakeFrame({Name="TitleBar", Size=UDim2.new(1,0,0,TBAR), ZIndex=11, Parent=mainFrame})
    R(tbar, "BackgroundColor3", "SecondaryBg"); MakeCorner(tbar, 10)
    local tbarPatch = MakeFrame({Size=UDim2.new(1,0,0,12), Position=UDim2.new(0,0,1,-12), ZIndex=11, Parent=tbar})
    R(tbarPatch, "BackgroundColor3", "SecondaryBg")
    local accentLine = MakeFrame({Size=UDim2.new(1,0,0,2), Position=UDim2.new(0,0,1,-1), ZIndex=12, Parent=tbar})
    R(accentLine, "BackgroundColor3", "Accent")
    local statusDot = MakeFrame({Size=UDim2.fromOffset(7,7), Position=UDim2.new(0,12,0.5,-3), ZIndex=13, Parent=tbar})
    MakeCorner(statusDot, 4)
    local dotColor = nil
    local function paintDot() statusDot.BackgroundColor3 = dotColor or th().TextDim end
    paintDot(); RF(paintDot)
    local titleLbl = MakeLabel({Size=UDim2.new(1,-110,1,0), Position=UDim2.new(0,26,0,0),
        Text=winName, Font=Enum.Font.GothamBold, TextSize=14, ZIndex=12,
